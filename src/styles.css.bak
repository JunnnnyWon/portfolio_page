@import url("https://cdn.jsdelivr.net/npm/pretendard/dist/web/static/pretendard.css");
@import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Syncopate:wght@400;700&display=swap");

:root {
  color: #fff;
  background: #090812;
  font-family:
    "Pretendard Variable",
    "Pretendard",
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --page-width: min(100vw, 27rem);
  --page-edge: clamp(1rem, 3vw, 1.5rem);
  --nav-height: 5.75rem;
  --surface: rgba(7, 10, 23, 0.7);
  --surface-strong: rgba(4, 7, 18, 0.92);
  --surface-border: rgba(255, 255, 255, 0.08);
  --muted: rgba(255, 255, 255, 0.66);
  --soft: rgba(255, 255, 255, 0.45);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  min-height: 100svh;
  background:
    radial-gradient(circle at top, rgba(91, 107, 255, 0.16), transparent 28%),
    radial-gradient(circle at bottom, rgba(187, 48, 255, 0.16), transparent 24%),
    linear-gradient(180deg, #1d2026 0%, #0a0b11 100%);
}

img {
  display: block;
  max-width: 100%;
  height: auto;
  object-fit: cover;
}

a {
  color: inherit;
  text-decoration: none;
}

.app-shell {
  display: grid;
  min-height: 100svh;
  place-items: start center;
}

.app-stage {
  position: relative;
  width: var(--page-width);
  min-height: 100svh;
  background: #090812;
  overflow: clip;
  box-shadow:
    0 24px 120px rgba(0, 0, 0, 0.5),
    0 12px 40px rgba(0, 0, 0, 0.35);
}

.portfolio-page {
  position: relative;
  width: 100%;
  overflow-x: clip;
}

.floating-nav {
  position: fixed;
  top: max(0.55rem, env(safe-area-inset-top));
  left: 50%;
  z-index: 30;
  width: min(calc(100vw - 1.1rem), calc(var(--page-width) - 1.2rem));
  max-width: 25.8rem;
  transform: translateX(-50%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1rem;
  background: rgba(8, 10, 24, 0.72);
  backdrop-filter: blur(24px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

.floating-nav__brand {
  display: none;
}

.floating-nav__brand strong {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.floating-nav__brand span {
  font-size: 0.62rem;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 0.02em;
}

.floating-nav__links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.2rem;
  overflow-x: auto;
  padding: 0.52rem 0.56rem;
  scrollbar-width: none;
}

.floating-nav__links::-webkit-scrollbar {
  display: none;
}

.floating-nav__links a {
  flex: 1 1 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 2rem;
  padding: 0.46rem 0.76rem;
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  white-space: nowrap;
  transition:
    background-color 220ms var(--ease-out),
    color 220ms var(--ease-out),
    transform 220ms var(--ease-out);
}

.floating-nav__links a.is-active {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  transform: translateY(-1px);
}

.scene {
  position: relative;
  width: 100%;
  scroll-margin-top: calc(var(--nav-height) + 1.25rem);
  isolation: isolate;
  --scene-veil-bottom: rgba(255, 255, 255, 0);
}

.scene::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 2;
}

.scene::after {
  bottom: -1px;
  height: 1.5rem;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0) 72%,
    var(--scene-veil-bottom) 100%
  );
  opacity: 1;
}

.scene > .scene__sticky,
.scene > .projects-stage,
.scene > .career-stage {
  position: relative;
  z-index: 1;
}

.scene__sticky {
  position: sticky;
  top: 0;
  height: 100svh;
  overflow: hidden;
}

.scene--hero {
  /* 창 높이가 너무 낮아지는 경우에도 콘텐츠가 겹치지 않게 절대적인 최소 높이 방어선(min)을 설정합니다 */
  min-height: max(100svh, 56rem);
  --scene-veil-bottom: rgba(0, 0, 0, 0);
  /* 워드마크(PORTFOLIO)와 계단(Stairs)이 항상 일정한 세로 간격을 유지하도록 CSS 변수를 심습니다 */
  --wordmark-top: 22.35rem;
  --stairs-offset-vw: 10vw;
  background:
    radial-gradient(circle at 84% 10%, rgba(214, 201, 247, 0.88), transparent 26%),
    radial-gradient(circle at 60% 58%, rgba(121, 150, 255, 0.16), transparent 34%),
    linear-gradient(180deg, #5c66a2 0%, #4d588f 30%, #2b3157 66%, #12172a 100%);
}

.hero-stage {
  position: relative;
  /* 동일하게 섹션 자체에도 든든한 최소 높이를 부여합니다 */
  min-height: max(100svh, 56rem);
  height: 100svh;
  overflow: hidden;
  background:
    radial-gradient(circle at 84% 10%, rgba(214, 201, 247, 0.88), transparent 26%),
    radial-gradient(circle at 60% 58%, rgba(121, 150, 255, 0.16), transparent 34%),
    linear-gradient(180deg, #5c66a2 0%, #4d588f 30%, #2b3157 66%, #12172a 100%);
}

.hero-stage__brand,
.hero-stage__nav,
.hero-stage__role,
.hero-stage__copy,
.hero-stage__visual {
  position: absolute;
  left: 4rem;
  z-index: 2;
}

.hero-stage__brand {
  top: 2rem;
  display: grid;
  gap: 0.25rem;
}

.hero-stage__brand strong,
.hero-stage__brand span,
.hero-stage__nav a,
.hero-stage__role,
.hero-stage__intro,
.hero-stage__body,
.hero-stage__stars {
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  word-break: keep-all;
  overflow-wrap: normal;
}

.hero-stage__brand strong {
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.05em;
}

.hero-stage__brand span {
  font-size: 0.92rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.hero-stage__nav {
  top: 5.75rem;
  display: flex;
  gap: 1rem;
}

.hero-stage__nav a {
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.hero-stage__role {
  top: 8.55rem;
  right: 1.9rem;
  width: auto;
  margin: 0;
  font-size: clamp(2.02rem, 5.1vw, 2.46rem);
  font-weight: 800;
  line-height: 1.14;
  letter-spacing: -0.06em;
  text-wrap: balance;
}

.hero-stage__visual {
  inset: 0;
  left: 0;
  z-index: 1;
}

.hero-stage__visual::before,
.hero-stage__visual::after {
  content: "";
  position: absolute;
  pointer-events: none;
}

.hero-stage__visual::before {
  top: 2.6rem;
  right: -0.9rem;
  width: 12.8rem;
  height: 33rem;
  background:
    linear-gradient(270deg, rgba(214, 205, 246, 0.34) 0%, rgba(173, 190, 255, 0.16) 34%, rgba(114, 132, 225, 0.04) 66%, rgba(114, 132, 225, 0) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 22%, rgba(23, 30, 64, 0) 100%);
  border-radius: 2.6rem 0 0 2.6rem;
  filter: blur(0.2rem);
  opacity: 0.95;
}

.hero-stage__visual::after {
  top: 17.4rem;
  right: 4.9rem;
  width: 16.2rem;
  height: 13.8rem;
  background: radial-gradient(circle at 50% 50%, rgba(130, 155, 255, 0.2) 0%, rgba(110, 132, 232, 0.11) 38%, rgba(31, 37, 76, 0) 76%);
  transform: rotate(-19deg);
  filter: blur(0.85rem);
  opacity: 0.9;
}

.hero-stage__stairs,
.hero-stage__orb,
.hero-stage__cursor {
  /* Inherit some properties if needed, but they are now spans */
}

.hero-stage__wordmark {
  position: absolute;
}

.hero-stage__stairs {
  position: absolute;
  /* 워드마크 상단 위치 기준 - 계단이 일정한 간격을 위로 유지하도록 calc 설정 */
  /* 단, 해상도가 커져 이미지가 팽창할 때 밑으로 처지는 걸 방지하도록 변수화된 vw(오프셋)를 더 빼줍니다. */
  top: calc(var(--wordmark-top) - 18rem - var(--stairs-offset-vw));
  right: 0;
  transform: translateX(35%);
  width: max(47.2rem, 80vw);
  max-width: none;
  opacity: 0.96;
}

.hero-stage__wordmark {
  top: var(--wordmark-top);
  left: 50%;
  display: grid;
  gap: 0.05rem;
  z-index: 1;
  transform: translateX(-50%) rotate(-7deg);
  transform-origin: center center;
  align-items: center;
  justify-items: center;
}

.hero-stage__wordmark span {
  display: block;
  font-weight: 900;
  line-height: 0.86;
  letter-spacing: -0.08em;
}

.hero-stage__wordmark-port {
  position: relative;
  font-size: clamp(5.9rem, 14.9vw, 6.7rem);
  color: #cfd7f0;
  text-shadow:
    0 0.12rem 0 rgba(255, 255, 255, 0.72),
    0 0.95rem 1.8rem rgba(25, 27, 52, 0.26);
}

.hero-stage__orb {
  position: absolute;
  top: -0.4em;
  left: -0.2em;
  width: 0.82em;
  z-index: 2;
  filter: drop-shadow(0 0.8rem 1.6rem rgba(24, 18, 50, 0.24));
  /* 요소(Element) 중심이 아닌 시각적(Visual) 겹침을 위해 translate 추가 */
  transform: translate(-30%, -40%) rotate(7deg);
}

.hero-stage__wordmark-folio {
  position: relative;
  font-size: clamp(6.45rem, 16.3vw, 7.25rem);
  color: #ffffff;
  text-shadow: 0 1rem 1.9rem rgba(25, 27, 52, 0.24);
}

.hero-stage__cursor {
  position: absolute;
  bottom: -0.4em;
  right: -0.6em;
  width: 0.7em;
  z-index: 3;
  filter: drop-shadow(0 0.75rem 1.55rem rgba(20, 15, 48, 0.3));
}

.hero-stage__copy {
  left: 1.85rem;
  right: 1.85rem;
  bottom: 0.95rem;
  max-width: 20.75rem;
}

.hero-stage__intro,
.hero-stage__body {
  margin: 0;
  font-size: 0.97rem;
  line-height: 1.76;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.94);
  text-wrap: pretty;
}

.hero-stage__body {
  margin-top: 1.2rem;
  color: rgba(255, 255, 255, 0.78);
}

.hero-stage__body strong {
  color: #fff;
}

.hero-stage__stars {
  margin-top: 0.75rem;
  font-size: 0.7rem;
  letter-spacing: 0.22em;
  color: rgba(255, 255, 255, 0.6);
}

@media (max-width: 31rem) {
  .scene--hero,
  .hero-stage {
    min-height: max(100svh, 56rem);
  }

  .hero-stage__copy {
    max-width: 18.8rem;
    bottom: 1.2rem;
  }

  .hero-stage__intro,
  .hero-stage__body {
    font-size: 0.93rem;
    line-height: 1.72;
  }
}

@media (max-width: 23rem) {
  .hero-stage__brand,
  .hero-stage__nav,
  .hero-stage__role,
  .hero-stage__copy {
    left: 1.6rem;
  }

  .hero-stage__brand {
    top: 1.8rem;
  }

  .hero-stage__nav {
    top: 5.25rem;
    gap: 0.82rem;
  }

  .hero-stage__nav a {
    font-size: 0.94rem;
  }

  .hero-stage__role {
    top: 7.8rem;
    right: 1.5rem;
    width: auto;
    font-size: 1.88rem;
  }

  .hero-stage__visual::before {
    top: 2.8rem;
    right: -0.8rem;
    width: 10.6rem;
    height: 29.6rem;
  }

  .hero-stage__visual::after {
    top: 15.9rem;
    right: 3.8rem;
    width: 13.2rem;
    height: 11.6rem;
  }

  .scene--hero {
    --wordmark-top: 21.75rem;
    --stairs-offset-vw: 10vw;
  }

  .hero-stage__copy {
    left: 1.6rem;
    right: 1.6rem;
    bottom: 0.95rem;
    max-width: 18.6rem;
  }

  .hero-stage__intro,
  .hero-stage__body {
    font-size: 0.88rem;
  }
}

.scene--profile {
  min-height: auto;
  scroll-margin-top: calc(var(--nav-height) + 2.35rem);
  --scene-veil-bottom: rgba(98, 95, 166, 0.98);
  background:
    linear-gradient(180deg, rgba(10, 8, 18, 0.22), rgba(10, 8, 18, 0.04)),
    linear-gradient(180deg, #877c96 0%, #7d718c 38%, #8e746c 100%);
}

.scene--profile .scene__sticky {
  position: relative;
  height: auto;
  overflow: visible;
}

.profile-stage {
  padding: calc(var(--nav-height) + 3rem) var(--page-edge) 4rem;
}

.profile-stage__background {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.profile-stage__ellipse,
.profile-stage__noise {
  position: absolute;
  max-width: none;
}

.profile-stage__ellipse--top {
  top: -8rem;
  right: -18rem;
  width: 48rem;
  opacity: 0.48;
  mix-blend-mode: screen;
}

.profile-stage__ellipse--bottom {
  left: -11rem;
  top: 9rem;
  width: 36rem;
  opacity: 0.42;
  mix-blend-mode: screen;
}

.profile-stage__noise {
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: color-burn;
  opacity: 0.2;
}

.profile-card {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 1.5rem;
  max-width: 24.5rem;
  transition: transform 420ms var(--ease-out);
  --profile-mode-accent: #84ff77;
}

.profile-card__heading {
  position: relative;
  padding-bottom: 0.2rem;
}

.profile-card__heading span {
  display: block;
  margin-bottom: -0.35rem;
  font-size: clamp(1.5rem, 7vw, 2.2rem);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.38);
  filter: blur(0.9px);
}

.profile-card__heading h2 {
  margin: 0;
  font-size: clamp(2rem, 9vw, 2.75rem);
  font-weight: 900;
  letter-spacing: -0.08em;
}

.profile-card__canvas {
  display: grid;
  gap: 0.9rem;
  width: min(100%, 22.1rem);
  margin: 0;
}

.profile-card__frame {
  position: relative;
  width: fit-content;
  max-width: 100%;
  padding: 0.7rem;
}

.profile-card__photo-shell {
  position: relative;
  width: fit-content;
  max-width: 100%;
  overflow: visible;
  border-radius: 0;
}

.profile-card__photo-shell::after {
  content: "";
  position: absolute;
  inset: auto 10% -1rem 10%;
  height: 2.4rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--profile-mode-accent) 50%, transparent);
  filter: blur(18px);
  opacity: 0.4;
  pointer-events: none;
}

.profile-card__photo {
  display: block;
  width: min(100%, 20.7rem);
  aspect-ratio: 447 / 560;
  object-fit: cover;
  border-radius: 0;
  box-shadow: 0 22px 50px rgba(0, 0, 0, 0.12);
}

.profile-card__photo-overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 68% 24%, color-mix(in srgb, var(--profile-mode-accent) 28%, transparent), transparent 34%),
    linear-gradient(180deg, transparent 52%, color-mix(in srgb, var(--profile-mode-accent) 18%, transparent) 100%);
  mix-blend-mode: screen;
  opacity: 0.78;
  pointer-events: none;
}

.profile-card__photo-frame {
  position: absolute;
  inset: -0.7rem;
  border: 3px dashed rgba(255, 255, 255, 0.92);
  border-radius: 0.3rem;
  pointer-events: none;
  opacity: 0.92;
}

.profile-card__editor {
  display: grid;
  gap: 0.7rem;
  width: min(100%, 22.1rem);
  margin-top: -0.05rem;
  justify-items: start;
}

.profile-editor__toolbar,
.profile-editor__prompt {
  position: relative;
  display: flex;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 0.8rem;
  background: rgba(55, 59, 73, 0.76);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.06),
    0 14px 30px rgba(16, 14, 22, 0.15);
  backdrop-filter: blur(18px);
}

.profile-editor__toolbar {
  width: 100%;
  min-height: 3rem;
  justify-content: flex-start;
  gap: 0.72rem;
  margin: 0;
  padding: 0.55rem 0.9rem;
}

.profile-editor__chip,
.profile-editor__mute,
.profile-editor__dots,
.profile-editor__prompt-text,
.profile-editor__generate {
  font-size: 0.72rem;
  color: rgba(255, 255, 255, 0.82);
  border: 0;
  appearance: none;
  cursor: pointer;
  background: transparent;
}

.profile-editor__modes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.42rem;
}

.profile-editor__mode {
  min-width: 3.15rem;
  padding: 0.44rem 0.72rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.72rem;
  font-weight: 700;
  transition:
    background-color 200ms var(--ease-out),
    color 200ms var(--ease-out),
    border-color 200ms var(--ease-out),
    transform 200ms var(--ease-out),
    box-shadow 200ms var(--ease-out);
}

.profile-editor__mode.is-active {
  color: #fff;
  border-color: color-mix(in srgb, var(--profile-mode-accent) 48%, rgba(255, 255, 255, 0.12));
  background: color-mix(in srgb, var(--profile-mode-accent) 18%, rgba(255, 255, 255, 0.02));
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--profile-mode-accent) 28%, transparent);
  transform: translateY(-1px);
}

.profile-editor__chip {
  padding: 0.5rem 0.65rem;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
}

.profile-editor__icon {
  position: relative;
  width: 1.05rem;
  height: 1.05rem;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 0.28rem;
  background: rgba(255, 255, 255, 0.05);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  opacity: 0.9;
}

.profile-editor__icon::before,
.profile-editor__icon::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.profile-editor__icon--crop::before {
  width: 0.58rem;
  height: 0.58rem;
  border-left: 0.11rem solid rgba(255, 255, 255, 0.88);
  border-top: 0.11rem solid rgba(255, 255, 255, 0.88);
}

.profile-editor__icon--crop::after {
  width: 0.44rem;
  height: 0.44rem;
  margin-left: 0.14rem;
  margin-top: 0.14rem;
  border-right: 0.11rem solid rgba(255, 255, 255, 0.72);
  border-bottom: 0.11rem solid rgba(255, 255, 255, 0.72);
}

.profile-editor__icon--layers::before {
  width: 0.5rem;
  height: 0.34rem;
  border: 0.09rem solid rgba(255, 255, 255, 0.86);
  border-radius: 0.08rem;
  box-shadow:
    -0.12rem -0.12rem 0 -0.02rem rgba(255, 255, 255, 0.45),
    0.12rem 0.12rem 0 -0.02rem rgba(255, 255, 255, 0.45);
}

.profile-editor__icon--spark::before {
  width: 0.62rem;
  height: 0.62rem;
  background: rgba(255, 255, 255, 0.9);
  clip-path: polygon(
    50% 0%,
    62% 34%,
    100% 50%,
    62% 66%,
    50% 100%,
    38% 66%,
    0% 50%,
    38% 34%
  );
}

.profile-editor__icon--mask::before {
  width: 0.56rem;
  height: 0.56rem;
  border-radius: 0.14rem;
  border: 0.09rem solid rgba(255, 255, 255, 0.86);
}

.profile-editor__icon--mask::after {
  width: 0.18rem;
  height: 0.18rem;
  margin-left: 0.1rem;
  margin-top: 0.1rem;
  border-radius: 0.05rem;
  background: rgba(255, 255, 255, 0.92);
}

.profile-editor__dots {
  font-size: 1rem;
  line-height: 1;
}

.profile-editor__mute {
  color: rgba(255, 255, 255, 0.72);
}

.profile-editor__prompt {
  width: 100%;
  min-height: 3.2rem;
  margin: 0;
  padding: 0.35rem;
}

.profile-editor__scroll {
  width: 0.22rem;
  align-self: stretch;
  margin-right: 0.35rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.58);
}

.profile-editor__prompt-text {
  flex: 1;
  min-height: 2.45rem;
  display: inline-flex;
  align-items: center;
  padding: 0 0.95rem;
  border: 1px solid rgba(94, 167, 255, 0.42);
  border-radius: 0.45rem;
  color: rgba(255, 255, 255, 0.96);
  background: color-mix(in srgb, var(--profile-mode-accent) 8%, rgba(255, 255, 255, 0.02));
  text-align: left;
  transition:
    border-color 220ms var(--ease-out),
    background-color 220ms var(--ease-out),
    transform 220ms var(--ease-out);
}

.profile-editor__prompt-text:hover,
.profile-editor__prompt-text:focus-visible {
  border-color: color-mix(in srgb, var(--profile-mode-accent) 56%, rgba(94, 167, 255, 0.42));
  background: color-mix(in srgb, var(--profile-mode-accent) 16%, rgba(255, 255, 255, 0.02));
  transform: translateY(-1px);
}

.profile-editor__generate {
  display: inline-flex;
  align-items: center;
  min-height: 2.45rem;
  padding: 0 0.8rem 0 0.35rem;
  color: rgba(255, 255, 255, 0.78);
  transition:
    color 200ms var(--ease-out),
    transform 200ms var(--ease-out);
}

.profile-editor__generate:hover,
.profile-editor__generate:focus-visible {
  color: #fff;
  transform: translateY(-1px);
}

.profile-editor__action {
  position: relative;
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: auto;
  min-height: 2.45rem;
  padding-right: 1.45rem;
}

.profile-editor__check {
  position: absolute;
  right: -0.78rem;
  top: -0.62rem;
  width: 2.1rem;
  height: 2.1rem;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #b9ff74, #6ad93d 72%);
  box-shadow:
    0 0 0 4px rgba(255, 255, 255, 0.08),
    0 14px 24px rgba(32, 84, 16, 0.24);
}

.profile-editor__check::before,
.profile-editor__check::after {
  content: "";
  position: absolute;
  background: #fff;
  border-radius: 999px;
}

.profile-editor__check::before {
  left: 0.58rem;
  top: 1.08rem;
  width: 0.34rem;
  height: 0.13rem;
  transform: rotate(42deg);
}

.profile-editor__check::after {
  left: 0.78rem;
  top: 0.88rem;
  width: 0.62rem;
  height: 0.13rem;
  transform: rotate(-46deg);
}

.profile-card__name-wrap {
  position: relative;
  width: 100%;
}

.profile-card__name {
  position: relative;
  z-index: 1;
  margin: 0;
  text-align: left;
  font-size: clamp(4.7rem, 19vw, 6.4rem);
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.08em;
  text-shadow:
    0 12px 22px rgba(12, 4, 24, 0.18),
    0 0 30px rgba(255, 255, 255, 0.08);
}

.profile-card__headline,
.profile-card__subcopy {
  margin: 0;
  text-align: left;
}

.profile-card__headline {
  margin-top: 0.8rem;
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: color-mix(in srgb, var(--profile-mode-accent) 56%, white);
}

.profile-card__subcopy {
  margin-top: 0.45rem;
  max-width: 20rem;
  font-size: 0.95rem;
  line-height: 1.62;
  color: rgba(255, 255, 255, 0.72);
}

.profile-card__meta {
  display: grid;
  gap: 2.25rem;
  margin-top: 0.7rem;
  transition: transform 520ms var(--ease-out);
}

.profile-card__roles {
  display: grid;
  gap: 1.35rem;
}

.profile-role {
  display: grid;
  grid-template-columns: 4.2rem 1fr;
  align-items: center;
  gap: 1rem;
  opacity: 0.45;
  transform: translateX(0);
  transition:
    opacity 220ms var(--ease-out),
    transform 220ms var(--ease-out);
}

.profile-role.is-active {
  opacity: 1;
  transform: translateX(0.22rem);
}

.profile-role__order {
  font-size: clamp(3rem, 12vw, 4.5rem);
  font-style: italic;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: -0.08em;
}

.profile-role__body {
  display: grid;
  gap: 0.25rem;
}

.profile-role__body small {
  font-size: 0.95rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.5);
}

.profile-role__body strong {
  font-size: clamp(1.75rem, 7vw, 2.1rem);
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: -0.05em;
}

.profile-role.is-active .profile-role__body strong {
  color: color-mix(in srgb, var(--profile-mode-accent) 30%, white);
}

.profile-card__tech {
  padding-top: 1.8rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.profile-card__tech p {
  margin: 0 0 1rem;
  font-size: 0.76rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.16em;
}

.profile-card__tech-grid {
  display: grid;
  grid-template-columns: repeat(3, max-content);
  justify-content: space-between;
  column-gap: 1.7rem;
  row-gap: 0.92rem;
  align-items: start;
}

.profile-card__tech-grid span {
  display: block;
  font-size: clamp(1rem, 4vw, 1.35rem);
  font-weight: 800;
  line-height: 1.15;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: -0.015em;
  opacity: 0.42;
  transform: translateY(0);
  transition:
    opacity 200ms var(--ease-out),
    color 200ms var(--ease-out),
    transform 200ms var(--ease-out),
    text-shadow 200ms var(--ease-out);
}

.profile-card__tech-grid span.is-active {
  opacity: 1;
  color: color-mix(in srgb, var(--profile-mode-accent) 44%, white);
  transform: translateY(-2px);
  text-shadow: 0 0 18px color-mix(in srgb, var(--profile-mode-accent) 20%, transparent);
}

.scene--projects {
  padding: calc(var(--nav-height) + 2.4rem) var(--page-edge) 16rem;
--scene-veil-bottom: rgba(17, 73, 150, 0.98);
  background:
    radial-gradient(circle at 18% 12%, rgba(171, 148, 255, 0.34), transparent 30%),
    radial-gradient(circle at 76% 18%, rgba(59, 105, 255, 0.16), transparent 24%),
    linear-gradient(180deg, #5f5c94 0%, #43478b 26%, #232d70 56%, #08103d 100%);
}

.projects-stage {
  display: grid;
  align-content: start;
  gap: 0.72rem;
}

.projects-stage__header {
  position: relative;
  z-index: 0;
  display: flex;
  flex-direction: column;
  gap: 0.72rem;
  align-items: flex-start;
}

.projects-stage__header-title {
  position: relative;
  padding-bottom: 0.2rem;
}

.projects-stage__backdrop {
  display: block;
  margin-bottom: -0.35rem;
  font-size: clamp(1.5rem, 7vw, 2.2rem);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.38);
  filter: blur(0.9px);
}

.projects-stage__header h2 {
  margin: 0;
  font-size: clamp(2rem, 9vw, 2.75rem);
  font-weight: 900;
  letter-spacing: -0.08em;
}

.projects-stage__underline {
  display: block;
  width: 3.7rem;
  height: 0.34rem;
  border-radius: 999px;
  background: linear-gradient(90deg, #2c8fff 0%, #2469ff 100%);
  box-shadow: 0 0 18px rgba(44, 143, 255, 0.32);
}

.projects-stage__header p {
  margin: 0;
  max-width: 21rem;
  font-size: 0.92rem;
  line-height: 1.6;
  letter-spacing: -0.03em;
  color: rgba(243, 242, 255, 0.68);
  position: relative;
  z-index: 1;
}

.projects-wall-shell {
  position: relative;
  z-index: 2;
  margin-top: 1rem;
}

.projects-wall__ambient {
  position: absolute;
  inset: 1.2rem -0.4rem auto;
  height: 15rem;
  border-radius: 2.4rem;
  filter: blur(28px);
  opacity: 0.92;
  pointer-events: none;
  background: radial-gradient(circle at 34% 24%, rgba(131, 117, 255, 0.26), transparent 58%);
  transition: background 220ms var(--ease-out), opacity 220ms var(--ease-out);
}

.projects-stage--violet .projects-wall__ambient {
  background: radial-gradient(circle at 30% 18%, rgba(170, 140, 255, 0.3), transparent 58%);
}

.projects-stage--cyan .projects-wall__ambient {
  background: radial-gradient(circle at 70% 16%, rgba(90, 227, 255, 0.24), transparent 55%);
}

.projects-stage--blue .projects-wall__ambient {
  background: radial-gradient(circle at 72% 20%, rgba(86, 150, 255, 0.28), transparent 58%);
}

.projects-stage--pink .projects-wall__ambient {
  background: radial-gradient(circle at 62% 20%, rgba(255, 110, 213, 0.24), transparent 58%);
}

.projects-wall {
  position: relative;
  z-index: 1;
  display: grid;
  align-items: stretch;
  grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
  grid-template-rows: repeat(6, minmax(0, clamp(2.56rem, 9.35vw, 3.02rem)));
  gap: 0.62rem;
}

.project-poster {
  --poster-accent: rgba(115, 146, 255, 0.84);
  --poster-accent-soft: rgba(115, 146, 255, 0.18);
  --poster-offset: 0rem;
  position: relative;
  display: grid;
  grid-template-rows: auto 1fr auto;
  align-content: normal;
  gap: 0.72rem;
  min-height: 0;
  padding: 0.82rem 0.84rem 0.88rem;
  overflow: hidden;
  border-radius: 1.55rem;
  border: 1px solid rgba(178, 196, 255, 0.12);
  background:
    linear-gradient(180deg, rgba(15, 27, 82, 0.93), rgba(5, 12, 43, 0.97)),
    rgba(8, 11, 30, 0.88);
  box-shadow:
    0 18px 42px rgba(3, 7, 28, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transform: translate3d(0, var(--poster-offset), 0) scale(1);
  transition:
    transform 220ms var(--ease-out),
    border-color 220ms var(--ease-out),
    box-shadow 220ms var(--ease-out),
    filter 220ms var(--ease-out),
    opacity 220ms var(--ease-out);
  isolation: isolate;
}

.project-poster::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    radial-gradient(circle at 82% 16%, var(--poster-accent-soft), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 34%);
  opacity: 0.88;
  pointer-events: none;
}

.project-poster::after {
  content: "";
  position: absolute;
  inset: auto -12% -38% 18%;
  height: 52%;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--poster-accent) 38%, transparent), transparent 70%);
  opacity: 0;
  filter: blur(12px);
  transition: opacity 220ms var(--ease-out);
  pointer-events: none;
}

.project-poster.is-active {
  z-index: 3;
  border-color: color-mix(in srgb, var(--poster-accent) 38%, rgba(255, 255, 255, 0.16));
  box-shadow:
    0 24px 52px rgba(4, 10, 35, 0.42),
    0 0 0 1px color-mix(in srgb, var(--poster-accent) 18%, transparent),
    inset 0 1px 0 rgba(255, 255, 255, 0.07);
  filter: saturate(1.08);
  transform: translate3d(0, calc(var(--poster-offset) - 0.16rem), 0) scale(1.03);
}

.project-poster.is-active::after {
  opacity: 0.92;
}

.project-poster--violet {
  --poster-accent: rgba(178, 146, 255, 0.94);
  --poster-accent-soft: rgba(178, 146, 255, 0.22);
}

.project-poster--cyan {
  --poster-accent: rgba(91, 228, 255, 0.92);
  --poster-accent-soft: rgba(91, 228, 255, 0.2);
}

.project-poster--blue {
  --poster-accent: rgba(97, 154, 255, 0.94);
  --poster-accent-soft: rgba(97, 154, 255, 0.22);
}

.project-poster--pink {
  --poster-accent: rgba(255, 121, 216, 0.92);
  --poster-accent-soft: rgba(255, 121, 216, 0.2);
}

.project-poster--slot-1 {
  grid-column: 1;
  grid-row: 2 / span 4;
  --poster-offset: -0.7rem;
}

.project-poster--slot-2 {
  grid-column: 2;
  grid-row: 1 / span 2;
  --poster-offset: -7.15rem;
  z-index: 4;
}

.project-poster--slot-3 {
  grid-column: 1;
  grid-row: 5 / span 2;
  --poster-offset: -0.78rem;
}

.project-poster--slot-4 {
  grid-column: 2;
  grid-row: 3 / span 4;
  --poster-offset: -4.15rem;
  z-index: 3;
}

.project-poster__chrome,
.project-poster__body {
  position: relative;
  z-index: 1;
}

.project-poster__chrome {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.7rem;
}

.project-poster__index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.35rem;
  padding: 0.38rem 0.68rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.95);
}

.project-poster__signal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 7.3rem;
  min-height: 1.7rem;
  padding: 0.34rem 0.64rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--poster-accent) 12%, rgba(255, 255, 255, 0.04));
  border: 1px solid color-mix(in srgb, var(--poster-accent) 18%, rgba(255, 255, 255, 0.06));
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--poster-accent) 58%, white);
  text-align: center;
  line-height: 1.3;
}

.project-poster__body {
  display: grid;
  align-content: end;
  gap: 0.52rem;
  min-width: 0;
  align-self: end;
}

.project-poster__eyebrow {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(232, 236, 255, 0.54);
}

.project-poster h3 {
  margin: 0;
  max-width: 100%;
  font-size: 1.04rem;
  line-height: 0.94;
  font-weight: 900;
  letter-spacing: -0.07em;
  color: rgba(255, 255, 255, 0.9);
  word-break: keep-all;
  overflow-wrap: anywhere;
  text-wrap: balance;
  transition:
    color 220ms var(--ease-out),
    text-shadow 220ms var(--ease-out);
}

.project-poster--slot-1 h3,
.project-poster--slot-4 h3 {
  max-width: 7.6ch;
  font-size: clamp(1.18rem, 5.2vw, 1.62rem);
}

.project-poster--slot-2 {
  padding-block: 0.78rem 0.74rem;
}

.project-poster--slot-2 .project-poster__body,
.project-poster--slot-3 .project-poster__body {
  gap: 0.28rem;
}

.project-poster--slot-2 .project-poster__signal,
.project-poster--slot-3 .project-poster__signal {
  max-width: 5.7rem;
  min-height: 1.5rem;
  padding-inline: 0.48rem;
  font-size: 0.52rem;
}

.project-poster--slot-2 h3 {
  max-width: 4.8ch;
  font-size: clamp(0.82rem, 3.45vw, 0.98rem);
}

.project-poster--slot-3 h3 {
  max-width: 4.9ch;
  font-size: clamp(0.8rem, 3.4vw, 0.96rem);
}

.project-poster--slot-4 h3 {
  max-width: 6.8ch;
}

.project-poster__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.project-poster__tags span {
  padding: 0.3rem 0.56rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.06);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: rgba(245, 246, 255, 0.74);
  transition:
    border-color 220ms var(--ease-out),
    background-color 220ms var(--ease-out),
    color 220ms var(--ease-out);
}

.project-poster--slot-2 .project-poster__tags,
.project-poster--slot-3 .project-poster__tags {
  gap: 0.34rem;
}

.project-poster--slot-2 .project-poster__tags span,
.project-poster--slot-3 .project-poster__tags span {
  padding: 0.24rem 0.46rem;
  font-size: 0.56rem;
}

.project-poster__summary {
  position: relative;
  z-index: 1;
  display: grid;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transform: translateY(0.45rem);
  transition:
    max-height 200ms var(--ease-out),
    opacity 180ms var(--ease-out),
    transform 180ms var(--ease-out);
}

.project-poster__summary p {
  margin: 0;
  display: -webkit-box;
  overflow: hidden;
  font-size: 0.76rem;
  line-height: 1.45;
  letter-spacing: -0.02em;
  color: rgba(237, 240, 255, 0.74);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.project-poster.is-active h3 {
  color: rgba(255, 255, 255, 0.99);
  text-shadow: 0 0 18px color-mix(in srgb, var(--poster-accent) 24%, transparent);
}

.project-poster.is-active .project-poster__tags span {
  border-color: color-mix(in srgb, var(--poster-accent) 26%, rgba(255, 255, 255, 0.08));
  background: color-mix(in srgb, var(--poster-accent) 11%, rgba(255, 255, 255, 0.08));
  color: rgba(255, 255, 255, 0.94);
}

.project-poster.is-active .project-poster__summary {
  max-height: 6.6rem;
  opacity: 1;
  transform: translateY(0);
}

.projects-stage[data-reduced-motion="true"] .project-poster {
  transition-duration: 160ms;
}

.projects-stage[data-reduced-motion="true"] .project-poster.is-active {
  transform: translate3d(0, var(--poster-offset), 0) scale(1.01);
}

.projects-stage[data-reduced-motion="true"] .project-poster__summary {
  transition-duration: 140ms;
}

@media (max-height: 51.25rem) {
  .projects-stage__header {
    gap: 0.78rem;
  }

  

  

  

  .projects-stage__header p {
    font-size: 0.84rem;
    line-height: 1.48;
  }

  .projects-wall {
    grid-template-rows: repeat(6, minmax(0, clamp(2.5rem, 9.3vw, 3rem)));
    gap: 0.62rem;
  }

  .projects-wall-shell {
    margin-top: 1rem;
  }

  .project-poster {
    padding: 0.72rem 0.76rem 0.76rem;
  }

  .project-poster__signal {
    max-width: 6.8rem;
    min-height: 1.52rem;
    font-size: 0.58rem;
  }

  .project-poster h3 {
    font-size: 0.98rem;
  }

  .project-poster--slot-1 h3,
  .project-poster--slot-4 h3 {
    font-size: clamp(1.14rem, 5vw, 1.58rem);
  }

  .project-poster--slot-2 h3,
  .project-poster--slot-3 h3 {
    font-size: clamp(0.88rem, 3.8vw, 1.04rem);
  }

  .project-poster__tags span {
    font-size: 0.62rem;
  }

  .project-poster__summary p {
    font-size: 0.72rem;
  }
}

@media (max-height: 43rem) {
  .scene--projects {
    padding-top: calc(var(--nav-height) + 1.6rem);
  }

  .projects-stage__header {
    gap: 0.62rem;
    padding-top: 0;
  }

  

  

  

  .projects-stage__header p {
    display: none;
  }

  .projects-wall-shell {
    margin-top: 1rem;
  }

  .projects-wall {
    grid-template-rows: repeat(6, minmax(0, 2.12rem));
    gap: 0.48rem;
  }

  .project-poster {
    gap: 0.54rem;
    padding: 0.64rem 0.68rem 0.68rem;
    border-radius: 1.3rem;
  }

  .project-poster__index {
    min-width: 2.15rem;
    padding: 0.32rem 0.58rem;
    font-size: 0.72rem;
  }

  .project-poster__signal {
    max-width: 6rem;
    min-height: 1.36rem;
    padding: 0.28rem 0.52rem;
    font-size: 0.54rem;
  }

  .project-poster__eyebrow {
    font-size: 0.56rem;
  }

  .project-poster h3 {
    font-size: 0.92rem;
  }

  .project-poster--slot-1 h3,
  .project-poster--slot-4 h3 {
    font-size: clamp(1.04rem, 4.6vw, 1.42rem);
  }

  .project-poster--slot-2 h3,
  .project-poster--slot-3 h3 {
    font-size: clamp(0.72rem, 3.25vw, 0.9rem);
  }

  .project-poster__tags span {
    padding: 0.24rem 0.46rem;
    font-size: 0.58rem;
  }

  .project-poster__summary p {
    font-size: 0.66rem;
    line-height: 1.38;
  }
}

.projects-orbit-shell {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 1rem;
  margin-top: 0.9rem;
  padding-top: 1rem;
  overflow: visible;
}

.projects-orbit__ambient {
  position: absolute;
  inset: 0 0 auto;
  height: 18rem;
  border-radius: 2.6rem;
  background: radial-gradient(circle at 50% 18%, rgba(113, 134, 255, 0.14), transparent 66%);
  filter: blur(20px);
  opacity: 0.58;
  pointer-events: none;
}

.projects-stage--violet .projects-orbit__ambient {
  background: radial-gradient(circle at 36% 18%, rgba(171, 141, 255, 0.16), transparent 66%);
}

.projects-stage--cyan .projects-orbit__ambient {
  background: radial-gradient(circle at 60% 18%, rgba(94, 228, 255, 0.14), transparent 64%);
}

.projects-stage--blue .projects-orbit__ambient {
  background: radial-gradient(circle at 52% 18%, rgba(98, 154, 255, 0.14), transparent 64%);
}

.projects-stage--pink .projects-orbit__ambient {
  background: radial-gradient(circle at 56% 18%, rgba(255, 121, 216, 0.14), transparent 64%);
}

.projects-orbit {
  position: relative;
  height: clamp(25.8rem, 68vh, 31rem);
  perspective: 1640px;
  transform-style: preserve-3d;
  touch-action: pan-y;
  overflow: visible;
  transform: translateY(0.8rem);
  transform-origin: center center;
}

.project-orbit-card {
  --orbit-accent: rgba(115, 146, 255, 0.88);
  --orbit-accent-soft: rgba(115, 146, 255, 0.2);
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(18.2rem, 84vw);
  min-height: 18.6rem;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 1.04rem;
  padding: 1.18rem 1.14rem 1.1rem;
  border: 1px solid rgba(181, 198, 255, 0.08);
  border-radius: 2.2rem;
  background:
    linear-gradient(180deg, rgba(19, 31, 91, 0.92), rgba(8, 16, 49, 0.94));
  box-shadow:
    0 12px 24px rgba(3, 8, 31, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  transform-style: preserve-3d;
  isolation: isolate;
  cursor: pointer;
  appearance: none;
  text-align: left;
  font: inherit;
  color: inherit;
  transition:
    transform 420ms var(--ease-out),
    opacity 320ms var(--ease-out),
    filter 320ms var(--ease-out),
    border-color 280ms var(--ease-out),
    box-shadow 280ms var(--ease-out);
}

.project-orbit-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent 28%);
  pointer-events: none;
}

.project-orbit-card__sheen {
  position: absolute;
  inset: auto -8% -24% 28%;
  height: 46%;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--orbit-accent) 12%, transparent), transparent 70%);
  filter: blur(12px);
  opacity: 0.18;
  pointer-events: none;
}

.project-orbit-card.is-active {
  border-color: color-mix(in srgb, var(--orbit-accent) 22%, rgba(255, 255, 255, 0.14));
  box-shadow:
    0 16px 30px rgba(5, 10, 36, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.project-orbit-card--violet {
  --orbit-accent: rgba(178, 146, 255, 0.94);
  --orbit-accent-soft: rgba(178, 146, 255, 0.22);
}

.project-orbit-card--cyan {
  --orbit-accent: rgba(91, 228, 255, 0.92);
  --orbit-accent-soft: rgba(91, 228, 255, 0.2);
}

.project-orbit-card--blue {
  --orbit-accent: rgba(97, 154, 255, 0.92);
  --orbit-accent-soft: rgba(97, 154, 255, 0.2);
}

.project-orbit-card--pink {
  --orbit-accent: rgba(255, 121, 216, 0.92);
  --orbit-accent-soft: rgba(255, 121, 216, 0.2);
}

.project-orbit-card__chrome,
.project-orbit-card__body {
  position: relative;
  z-index: 1;
}

.project-orbit-card__chrome {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.72rem;
}

.project-orbit-card__index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.8rem;
  padding: 0.46rem 0.84rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.05);
  font-size: 0.92rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.96);
}

.project-orbit-card__signal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 9.4rem;
  min-height: 2.16rem;
  padding: 0.42rem 0.88rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--orbit-accent) 8%, rgba(255, 255, 255, 0.03));
  border: 1px solid color-mix(in srgb, var(--orbit-accent) 12%, rgba(255, 255, 255, 0.05));
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  line-height: 1.28;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--orbit-accent) 60%, white);
  text-align: center;
}

.project-orbit-card__body {
  display: grid;
  align-content: end;
  gap: 0.72rem;
}

.project-orbit-card__eyebrow {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(232, 236, 255, 0.54);
}

.project-orbit-card h3 {
  margin: 0;
  max-width: 8.6ch;
  font-size: clamp(1.62rem, 7.2vw, 2.34rem);
  line-height: 0.9;
  font-weight: 900;
  letter-spacing: -0.07em;
  color: rgba(255, 255, 255, 0.96);
  word-break: keep-all;
  text-wrap: balance;
}

.project-orbit-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.project-orbit-card__tags span {
  padding: 0.36rem 0.68rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.04);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: rgba(245, 246, 255, 0.74);
}

.projects-stage[data-reduced-motion="true"] .project-orbit-card {
  transition-duration: 180ms;
}

@media (max-height: 43rem) {
  .projects-orbit-shell {
    gap: 0.82rem;
    margin-top: 0.5rem;
    padding-top: 0.8rem;
  }

  .projects-orbit {
    height: 22.6rem;
    transform: translateY(0.35rem);
  }

  .project-orbit-card {
    width: min(16.4rem, 80vw);
    min-height: 16.8rem;
    padding: 0.98rem 0.96rem 0.92rem;
    border-radius: 1.86rem;
  }

  .project-orbit-card__signal {
    max-width: 7.6rem;
    min-height: 1.86rem;
    font-size: 0.62rem;
  }

  .project-orbit-card h3 {
    font-size: clamp(1.26rem, 5.8vw, 1.84rem);
  }

}

.projects-stage--showcase {
  --scene-veil-bottom: rgba(18, 21, 58, 0.98);
}

.projects-stage--showcase .projects-stage__header {
  gap: 0.62rem;
}







.projects-stage--showcase .projects-stage__underline {
  width: 2rem;
  height: 0.12rem;
  box-shadow: none;
}

.projects-stage--showcase .projects-stage__header p {
  max-width: 18rem;
  font-size: 0.74rem;
  line-height: 1.46;
  color: rgba(238, 241, 255, 0.52);
}

.projects-showcase {
  position: relative;
  z-index: 2;
  display: grid;
  margin-top: 1.14rem;
}

.projects-card-stack {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
  position: relative;
}


.projects-card-stack > li {
  list-style: none;
  position: sticky;
  top: calc(var(--nav-height, 6rem) + 1.5rem + var(--stack-offset, 0px));
}

.projects-card-stack > li:nth-child(1) { --stack-offset: 0rem; }
.projects-card-stack > li:nth-child(2) { --stack-offset: 2rem; }
.projects-card-stack > li:nth-child(3) { --stack-offset: 4rem; }


.projects-card {
  --project-accent: rgba(132, 155, 255, 0.84);
  --project-accent-soft: rgba(132, 155, 255, 0.16);
  position: relative;
  display: grid;
  gap: 1.08rem;
  width: 100%;
  min-height: 18.6rem;
  padding: 1.2rem 1.18rem 1.22rem;
  overflow: hidden;
  border-radius: 1.7rem;
  border: 1px solid rgba(255, 255, 255, 0.03);
  background: #080912;
  box-shadow:
    0 24px 48px rgba(0, 0, 0, 0.8),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  transition:
    border-color 300ms var(--ease-out),
    box-shadow 300ms var(--ease-out),
    background 300ms var(--ease-out),
    transform 300ms var(--ease-out);
  isolation: isolate;
  appearance: none;
  text-align: left;
  font: inherit;
  color: inherit;
  cursor: pointer;
}

.projects-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0) 40%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 1;
  transition: opacity 400ms var(--ease-out);
}

.projects-card:hover {
  background: #0b0d19;
  border-color: transparent;
  box-shadow:
    0 32px 64px rgba(0, 0, 0, 0.9),
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 0 40px color-mix(in srgb, var(--project-accent) 15%, transparent);
}

.projects-card:hover::after {
  opacity: 1;
  background: linear-gradient(135deg, color-mix(in srgb, var(--project-accent) 50%, rgba(255,255,255,0.2)), transparent 60%);
}

.projects-card:focus-visible {
  outline: 2px solid color-mix(in srgb, var(--project-accent) 78%, white);
  outline-offset: 3px;
}

.projects-card--violet {
  --project-accent: rgba(188, 151, 255, 0.88);
  --project-accent-soft: rgba(188, 151, 255, 0.16);
}

.projects-card--cyan {
  --project-accent: rgba(103, 231, 255, 0.88);
  --project-accent-soft: rgba(103, 231, 255, 0.16);
}

.projects-card--blue {
  --project-accent: rgba(108, 156, 255, 0.88);
  --project-accent-soft: rgba(108, 156, 255, 0.16);
}

.projects-card--pink {
  --project-accent: rgba(255, 136, 214, 0.88);
  --project-accent-soft: rgba(255, 136, 214, 0.16);
}

.projects-card__bar,
.projects-card__top,
.projects-card__body,
.projects-card__footer {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.projects-card__bar {
  width: 4.4rem;
  height: 0.18rem;
  border-radius: 999px;
  background: linear-gradient(90deg, color-mix(in srgb, var(--project-accent) 88%, white), color-mix(in srgb, var(--project-accent) 18%, transparent));
}

.projects-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}

.projects-card__heading {
  display: flex;
  gap: 0.86rem;
  align-items: center;
}

.projects-card__index {
  display: inline-flex;
  align-items: center;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.85rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.4);
}

.projects-card__meta {
  display: block;
  font-size: clamp(1.2rem, 4vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: #ffffff;
}

.projects-card__spark {
  position: relative;
  width: 1.1rem;
  height: 1.1rem;
  margin-top: 0.08rem;
}

.projects-card__spark::before,
.projects-card__spark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100%;
  height: 0.08rem;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--project-accent) 90%, white), transparent);
  transform: translate(-50%, -50%);
}

.projects-card__spark::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.projects-card__body {
  display: grid;
  gap: 0.68rem;
}

.projects-card__body p {
  margin: 0;
  max-width: 90%;
  font-size: 0.95rem;
  line-height: 1.5;
  font-weight: 300;
  letter-spacing: -0.01em;
  color: rgba(255, 255, 255, 0.8);
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  line-clamp: 3;
}



.projects-card__visual::before {
  content: "";
  position: absolute;
  inset: 1rem 0.4rem 0.7rem;
  border-radius: 1.6rem;
  background:
    radial-gradient(circle at top, color-mix(in srgb, var(--project-accent) 20%, transparent), transparent 58%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0));
  opacity: 0.9;
}

.projects-card:hover .projects-card:hover .projects-card:hover .projects-card__footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: auto;
}

.projects-card__note {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  width: 100%;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.6);
  transition: color 300ms;
}
.projects-card:hover .projects-card__note {
  color: #fff;
}

.projects-card__arrow {
  position: relative;
  display: inline-block;
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: color-mix(in srgb, var(--project-accent) 80%, white);
  transition: transform 300ms var(--ease-out);
}
.projects-card:hover .projects-card__arrow {
  transform: translateX(4px);
}

.projects-card__arrow::before,
.projects-card__arrow::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(241, 245, 255, 0.84);
  transform-origin: center;
}

.projects-card__arrow::before {
  width: 0.5rem;
  height: 0.08rem;
  transform: translate(-40%, -50%);
}

.projects-card__arrow::after {
  width: 0.34rem;
  height: 0.08rem;
  transform: translate(-4%, -155%) rotate(45deg);
  box-shadow: 0 0.2rem 0 rgba(241, 245, 255, 0.84);
}

.projects-card:hover .projects-card__note {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.5rem;
  width: 100%;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.6);
  transition: color 300ms;
}
.projects-card:hover .projects-card__note {
  color: #fff;
}

.projects-card:hover .projects-card__arrow {
  position: relative;
  display: inline-block;
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: color-mix(in srgb, var(--project-accent) 80%, white);
  transition: transform 300ms var(--ease-out);
}
.projects-card:hover .projects-card__arrow {
  transform: translateX(4px);
}

.detail-page {
  --detail-accent: rgba(188, 151, 255, 0.88);
  --detail-accent-soft: rgba(188, 151, 255, 0.16);
  position: fixed;
  inset: 0;
  z-index: 60;
  min-height: 100svh;
  background-color: #030408;
  background-image: none;
  overflow-y: auto;
  overflow-x: clip;
}

.detail-page::before {
  content: "";
  position: absolute;
  inset: -20%;
  background:
    radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--detail-accent) 25%, transparent) 0%, transparent 35%),
    radial-gradient(circle at 80% 30%, color-mix(in srgb, var(--detail-accent) 8%, transparent) 0%, transparent 40%),
    radial-gradient(circle at 20% 70%, color-mix(in srgb, var(--detail-accent) 5%, transparent) 0%, transparent 40%);
  filter: blur(60px);
  pointer-events: none;
  z-index: 0;
}

.detail-page--violet {
  --detail-accent: rgba(188, 151, 255, 0.88);
  --detail-accent-soft: rgba(188, 151, 255, 0.16);
}

.detail-page--cyan {
  --detail-accent: rgba(103, 231, 255, 0.88);
  --detail-accent-soft: rgba(103, 231, 255, 0.16);
}

.detail-page--blue {
  --detail-accent: rgba(108, 156, 255, 0.88);
  --detail-accent-soft: rgba(108, 156, 255, 0.16);
}

.detail-nav,
.detail-shell {
  position: relative;
  z-index: 1;
}

.detail-nav {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 0.8rem;
  padding: max(0.7rem, env(safe-area-inset-top)) var(--page-edge) 0.68rem;
  backdrop-filter: blur(20px);
  background: rgba(7, 10, 22, 0.64);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  z-index: 6;
}

.detail-nav__back,
.detail-nav__links a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2rem;
  padding: 0.46rem 0.76rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.detail-nav__back {
  appearance: none;
  cursor: pointer;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  line-height: 1;
  color: rgba(255, 255, 255, 0.7);
  background: #080912;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 300ms;
}

.detail-nav__back:hover {
  color: #fff;
  border-color: color-mix(in srgb, var(--detail-accent) 50%, rgba(255,255,255,0.4));
  background: color-mix(in srgb, var(--detail-accent) 15%, #080912);
}

.detail-nav__back--inline {
  width: fit-content;
  margin-top: 0.4rem;
}

.detail-nav__links {
  display: flex;
  gap: 0.32rem;
}

.detail-nav__links a {
  color: rgba(232, 236, 255, 0.62);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.detail-shell {
  display: grid;
  gap: 1.1rem;
  padding: 1rem var(--page-edge) 2.4rem;
}

.detail-shell--gallery {
  min-height: calc(100svh - 4.4rem);
  grid-template-rows: auto minmax(0, 1fr);
  gap: 0.9rem;
  padding-bottom: 1rem;
}

.detail-shell--not-found {
  min-height: calc(100svh - 4rem);
  align-content: center;
}

.detail-title {
  position: relative;
  display: grid;
  gap: 0.2rem;
  min-height: 7rem;
  padding-top: 0.2rem;
  overflow: visible;
}

.detail-title--gallery {
  gap: 0.62rem;
  min-height: auto;
}

.detail-title__backdrop {
  display: block;
  font-size: clamp(3.7rem, 14.2vw, 5.4rem);
  font-weight: 900;
  line-height: 0.88;
  letter-spacing: -0.08em;
  color: rgba(255, 255, 255, 0.26);
  filter: blur(3.6px);
}

.detail-title h1 {
  position: relative;
  z-index: 1;
  margin: -1.5rem 0 0;
  font-size: clamp(3rem, 12.4vw, 4.3rem);
  font-weight: 900;
  line-height: 0.84;
  letter-spacing: -0.09em;
  color: rgba(255, 255, 255, 0.98);
}

.detail-title__gallery-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.detail-title__gallery-kicker {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 0.42rem 0.74rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--detail-accent-soft) 84%, rgba(255, 255, 255, 0.03));
  border: 1px solid color-mix(in srgb, var(--detail-accent) 22%, rgba(255, 255, 255, 0.08));
  box-shadow:
    0 12px 24px rgba(1, 5, 24, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  font-size: 0.62rem;
  font-weight: 900;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--detail-accent) 58%, white);
}

.detail-hero {
  position: relative;
  display: grid;
  gap: 1rem;
  padding: 1.2rem;
  overflow: hidden;
  border-radius: 2rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background:
    linear-gradient(180deg, rgba(18, 22, 48, 0.94), rgba(8, 11, 28, 0.98)),
    rgba(8, 11, 24, 0.94);
  box-shadow:
    0 24px 50px rgba(1, 5, 24, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  isolation: isolate;
}

.detail-hero--not-found {
  min-height: 22rem;
  align-items: center;
}

.detail-hero__copy,
.detail-hero__metrics {
  position: relative;
  z-index: 1;
}

.detail-hero__copy {
  display: grid;
  gap: 0.72rem;
}

.detail-hero__eyebrow,
.detail-section__header span {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--detail-accent) 52%, white);
}

.detail-hero h1,
.detail-section__header h2 {
  margin: 0;
  line-height: 0.96;
  letter-spacing: -0.07em;
  color: rgba(255, 255, 255, 0.98);
  text-wrap: balance;
}

.detail-hero h1 {
  font-size: clamp(2rem, 8.2vw, 3.2rem);
}

.detail-hero__summary,
.detail-hero__lead,
.detail-section__lead,
.detail-panel p,
.detail-step__body p,
.detail-outcomes li {
  position: relative;
  padding: 1.2rem 1.2rem 1.2rem 2.8rem;
  border-radius: 1.4rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-hero__lead {
  color: rgba(245, 247, 255, 0.82);
}

.detail-hero__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.46rem;
}

.detail-hero__tags span,
.detail-related-card span {
  padding: 0.38rem 0.68rem;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: color-mix(in srgb, var(--detail-accent-soft) 84%, rgba(255, 255, 255, 0.03));
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: rgba(243, 246, 255, 0.82);
}

.detail-hero__metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.68rem;
}

.detail-hero__index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  grid-column: 1 / -1;
  width: fit-content;
  min-width: 3rem;
  padding: 0.52rem 0.92rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.84rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.96);
}

.detail-metric,
.detail-panel,
.detail-step,
.detail-related-card {
  border: 1px solid rgba(255, 255, 255, 0.08);
  background:
    linear-gradient(180deg, rgba(18, 22, 48, 0.84), rgba(9, 12, 29, 0.96)),
    rgba(9, 12, 29, 0.92);
  box-shadow:
    0 18px 36px rgba(1, 5, 24, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.detail-metric {
  display: grid;
  gap: 0.18rem;
  padding: 0.92rem 0.94rem;
  border-radius: 1.32rem;
}

.detail-metric strong {
  font-size: 0.98rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.96);
}

.detail-metric span {
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(215, 223, 255, 0.54);
}

.detail-hero__orb {
  position: absolute;
  border-radius: 999px;
  pointer-events: none;
  filter: blur(10px);
}

.detail-hero__orb--a {
  right: -2.6rem;
  top: -2rem;
  width: 11rem;
  height: 11rem;
  background: radial-gradient(circle, color-mix(in srgb, var(--detail-accent) 18%, transparent), transparent 70%);
}

.detail-hero__orb--b {
  left: -3.2rem;
  bottom: -4.2rem;
  width: 12rem;
  height: 12rem;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.08), transparent 70%);
}

.detail-section {
  display: grid;
  gap: 0.86rem;
  margin: 0;
}

.detail-section--gallery-only {
  min-height: 0;
  align-content: stretch;
}

.detail-section--projects {
  gap: 1rem;
}

.detail-section__header {
  display: grid;
  gap: 0.42rem;
}

.detail-section__lead {
  max-width: 33rem;
  color: rgba(233, 237, 255, 0.66);
}

.detail-section__header h2 {
  font-size: clamp(1.3rem, 5.8vw, 2rem);
}

.detail-panel-grid,
.detail-related-grid {
  display: grid;
  gap: 0.78rem;
}

.detail-panel {
  display: grid;
  gap: 0.8rem;
  padding: 1.8rem;
  border-radius: 2.2rem;
  background: rgba(20, 22, 35, 0.2);
  backdrop-filter: blur(48px);
  -webkit-backdrop-filter: blur(48px);
  border: 1px solid rgba(255, 255, 255, 0.03);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.1),
    0 24px 48px rgba(0, 0, 0, 0.4);
}

.detail-panel h3,
.detail-step__body h3,
.detail-related-card strong {
  margin: 0;
  font-size: 1rem;
  line-height: 1.02;
  letter-spacing: -0.05em;
  color: rgba(255, 255, 255, 0.96);
}

.detail-timeline {
  display: grid;
  gap: 0.78rem;
}

.detail-step {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.82rem;
  align-items: start;
  padding: 1.2rem;
  border-radius: 1.6rem;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-step__phase {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
  padding: 0.4rem 0.6rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--detail-accent) 40%, transparent);
  background: color-mix(in srgb, var(--detail-accent) 20%, transparent);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--detail-accent) 90%, white);
}

.detail-step__body {
  display: grid;
  gap: 0.4rem;
}

.detail-outcomes {
  display: grid;
  gap: 0.7rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.detail-outcomes li {
  position: relative;
  padding: 1.2rem 1.2rem 1.2rem 2.8rem;
  border-radius: 1.4rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-outcomes li::before {
  content: "";
  position: absolute;
  left: 1rem;
  top: 1.12rem;
  width: 0.78rem;
  height: 0.78rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--detail-accent) 72%, white);
  box-shadow: 0 0 16px color-mix(in srgb, var(--detail-accent) 34%, transparent);
}

.detail-related-card {
  display: grid;
  gap: 0.44rem;
  padding: 1rem;
  width: 100%;
  border-radius: 1.52rem;
  appearance: none;
  cursor: pointer;
  font: inherit;
  text-align: left;
  color: inherit;
  transition:
    transform 220ms var(--ease-out),
    border-color 220ms var(--ease-out),
    box-shadow 220ms var(--ease-out);
}

.detail-related-card small {
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(216, 224, 255, 0.48);
}

.detail-related-card span {
  width: fit-content;
}

.detail-related-card:hover {
  border-color: color-mix(in srgb, var(--detail-accent) 24%, rgba(255, 255, 255, 0.08));
  box-shadow:
    0 22px 42px rgba(1, 5, 24, 0.26),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-related-card--violet {
  --detail-accent: rgba(188, 151, 255, 0.88);
  --detail-accent-soft: rgba(188, 151, 255, 0.16);
}

.detail-related-card--cyan {
  --detail-accent: rgba(103, 231, 255, 0.88);
  --detail-accent-soft: rgba(103, 231, 255, 0.16);
}

.detail-related-card--blue {
  --detail-accent: rgba(108, 156, 255, 0.88);
  --detail-accent-soft: rgba(108, 156, 255, 0.16);
}

.detail-case-list {
  display: grid;
  gap: 1rem;
}

.detail-case {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.4rem;
  padding: 2.2rem;
  border-radius: 2.4rem;
  border: 1px solid rgba(255, 255, 255, 0.05);
  background: linear-gradient(145deg, rgba(20, 22, 35, 0.4), rgba(10, 11, 18, 0.6));
  backdrop-filter: blur(48px);
  -webkit-backdrop-filter: blur(48px);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.15),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05),
    0 32px 64px rgba(0, 0, 0, 0.7);
}

@media (min-width: 1024px) {
  .detail-case {
    grid-template-columns: 1.2fr 1.8fr; /* Split layout for Spatial UI */
    align-items: center;
  }
}

.detail-case__info {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.detail-case__media-window {
  display: block;
  width: 100%;
}


.detail-case__copy {
  display: grid;
  gap: 0.78rem;
}

.detail-case__heading {
  display: flex;
  align-items: center;
  gap: 0.72rem;
}

.detail-case__index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.3rem;
  padding: 0.4rem 0.7rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--detail-accent) 40%, transparent);
  background: color-mix(in srgb, var(--detail-accent) 20%, transparent);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: color-mix(in srgb, var(--detail-accent) 90%, white);
}

.detail-case__eyebrow-group {
  display: grid;
  gap: 0.18rem;
}

.detail-case__eyebrow-group small,
.detail-case__eyebrow-group span,
.detail-case__meta dt {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(219, 226, 255, 0.54);
}

.detail-case__title-row {
  display: grid;
  gap: 0.5rem;
}

.detail-case__title-row h3 {
  margin: 0;
  font-size: clamp(1.36rem, 6vw, 2rem);
  line-height: 0.98;
  letter-spacing: -0.06em;
  color: rgba(255, 255, 255, 0.98);
}

.detail-case__award {
  width: fit-content;
  padding: 0.38rem 0.68rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--detail-accent) 28%, rgba(255, 255, 255, 0.08));
  background: color-mix(in srgb, var(--detail-accent-soft) 92%, rgba(255, 255, 255, 0.03));
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: rgba(246, 248, 255, 0.92);
}

.detail-case__summary,
.detail-case__highlights li,
.detail-case__fact,
.detail-media figcaption {
  margin: 0;
  font-size: 0.8rem;
  line-height: 1.62;
  letter-spacing: -0.01em;
  color: rgba(233, 237, 255, 0.7);
}

.detail-case__summary {
  color: rgba(246, 248, 255, 0.88);
  font-weight: 600;
}

.detail-case__facts {
  display: flex;
  flex-wrap: wrap;
  gap: 0.52rem;
}

.detail-case__fact {
  display: inline-flex;
  flex-direction: column;
  gap: 0.18rem;
  padding: 0.58rem 0.72rem;
  border-radius: 1rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.035);
  color: rgba(246, 248, 255, 0.84);
}

.detail-case__fact em,
.detail-case__gallery-header span,
.detail-case__gallery-header small {
  font-style: normal;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(216, 224, 255, 0.5);
}

.detail-case__fact--accent {
  border-color: color-mix(in srgb, var(--detail-accent) 26%, rgba(255, 255, 255, 0.08));
  background: color-mix(in srgb, var(--detail-accent-soft) 86%, rgba(255, 255, 255, 0.03));
}

.detail-case__highlights {
  display: grid;
  gap: 0.52rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.detail-case__highlights li {
  position: relative;
  padding-left: 1.1rem;
}

.detail-case__highlights li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.58rem;
  width: 0.42rem;
  height: 0.42rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--detail-accent) 72%, white);
  box-shadow: 0 0 14px color-mix(in srgb, var(--detail-accent) 28%, transparent);
}

.detail-case__gallery-shell {
  display: grid;
  gap: 0.56rem;
}

.detail-case__gallery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
}

.rewards-gallery {
  display: grid;
  gap: 0.92rem;
}

.rewards-gallery__intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  padding-inline: 0.08rem;
}

.rewards-gallery__intro span {
  font-size: 0.62rem;
  font-weight: 900;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--detail-accent) 56%, white);
}

.rewards-gallery__intro small {
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: rgba(220, 227, 255, 0.56);
}

.rewards-gallery__grid {
  display: grid;
  gap: 0.92rem;
}

.rewards-card {
  position: relative;
  display: grid;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: 1.8rem;
  border: 1px solid rgba(255, 255, 255, 0.03);
  background: rgba(20, 22, 35, 0.25);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.08),
    0 16px 32px rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.rewards-card::before { display: none; }

.rewards-card--featured {
  border-color: color-mix(in srgb, var(--detail-accent) 40%, rgba(255, 255, 255, 0.2));
}

.rewards-card__frame {
  position: relative;
  display: grid;
  place-items: center;
  min-height: clamp(18rem, 56vw, 28rem);
  overflow: hidden;
  border-radius: 1.18rem;
  padding: 0.44rem;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)),
    rgba(255, 255, 255, 0.03);
}

.rewards-card:not(.rewards-card--featured) .rewards-card__frame {
  min-height: clamp(15rem, 52vw, 21rem);
}

.rewards-card__frame img,
.rewards-card__frame video {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 0.92rem;
  background: rgba(0, 0, 0, 0.18);
  object-fit: cover;
  object-position: center;
}

.rewards-card__body {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 0.5rem;
}

.rewards-card__eyebrow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.42rem;
}

.rewards-card__index,
.rewards-card__chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  font-family: inherit;
  background: color-mix(in srgb, var(--detail-accent) 15%, transparent);
  border: 1px solid color-mix(in srgb, var(--detail-accent) 30%, transparent);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: color-mix(in srgb, var(--detail-accent) 80%, white);
}

.rewards-card__index {
  padding: 0.34rem 0.62rem;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(247, 249, 255, 0.92);
}

.rewards-card__chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  font-family: inherit;
  background: color-mix(in srgb, var(--detail-accent) 15%, transparent);
  border: 1px solid color-mix(in srgb, var(--detail-accent) 30%, transparent);
  font-size: 0.65rem;
  letter-spacing: 0.05em;
  color: color-mix(in srgb, var(--detail-accent) 80%, white);
}

.rewards-card__body h3 {
  margin: 0;
  font-family: "Syncopate", sans-serif;
  font-size: clamp(1.1rem, 6vw, 1.44rem);
  line-height: 1;
  letter-spacing: -0.03em;
  color: rgba(247, 249, 255, 0.96);
  text-transform: uppercase;
}

.rewards-card__body p {
  margin: 0;
  font-size: 0.78rem;
  line-height: 1.62;
  color: rgba(224, 231, 255, 0.76);
}

.detail-case__gallery {
  --detail-gallery-frame-height: 24rem;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: max-content;
  gap: 1rem;
  overflow-x: auto;
  padding-bottom: 0.18rem;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
}

.detail-case__gallery--hackathon {
  --detail-reward-card-width: min(82vw, 20rem);
  padding-inline: max(0.85rem, calc(50% - (var(--detail-reward-card-width) / 2)));
  scroll-padding-inline: 50%;
  perspective: 1200px;
  perspective-origin: center center;
  overscroll-behavior-x: contain;
}

.detail-case__gallery::-webkit-scrollbar {
  display: none;
}

.detail-case__gallery .detail-media {
  position: relative;
  display: grid;
  gap: 0.72rem;
  padding: 0.8rem;
  border-radius: 1.6rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-case__gallery--hackathon .detail-media {
  position: relative;
  display: grid;
  gap: 0.72rem;
  padding: 0.8rem;
  border-radius: 1.6rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-media {
  position: relative;
  display: grid;
  gap: 0.72rem;
  padding: 0.8rem;
  border-radius: 1.6rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.detail-media--hackathon {
  position: relative;
  width: calc(var(--detail-reward-card-width) + 1.44rem);
  border-radius: 1.6rem;
  border-color: color-mix(in srgb, var(--detail-accent) 14%, rgba(255, 255, 255, 0.08));
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
    linear-gradient(180deg, rgba(18, 22, 48, 0.96), rgba(7, 9, 24, 0.98));
  box-shadow:
    0 18px 34px rgba(2, 5, 20, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
  transform-origin: center center;
  transform:
    translateY(var(--detail-gallery-card-translate-y, 0))
    translateZ(var(--detail-gallery-card-translate-z, 0))
    rotateY(var(--detail-gallery-card-rotate-y, 0deg))
    scale(var(--detail-gallery-card-scale, 1));
  opacity: var(--detail-gallery-card-opacity, 1);
  filter: blur(var(--detail-gallery-card-blur, 0));
  transition:
    transform 260ms var(--ease-out),
    opacity 260ms var(--ease-out),
    filter 260ms var(--ease-out),
    border-color 260ms var(--ease-out),
    box-shadow 260ms var(--ease-out);
}

.detail-media--hackathon::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background:
    linear-gradient(
      135deg,
      color-mix(in srgb, var(--detail-accent) calc(var(--detail-gallery-card-accent-opacity, 0.6) * 100%), transparent),
      rgba(255, 255, 255, 0.08)
    );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.detail-media--hackathon.is-active {
  box-shadow:
    0 26px 48px rgba(2, 5, 20, 0.4),
    0 0 0 1px color-mix(in srgb, var(--detail-accent) 16%, transparent),
    inset 0 1px 0 rgba(255, 255, 255, 0.12);
}

.detail-media__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.detail-media__index,
.detail-media__label {
  font-size: 0.64rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.detail-media__index {
  color: rgba(255, 255, 255, 0.9);
}

.detail-media__label {
  color: rgba(219, 226, 255, 0.52);
}

.detail-media__frame {
  position: relative;
  width: 100%;
  border-radius: 1rem;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.03);
  box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.5);
}

.detail-media img,
.detail-media video {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 0.96rem;
  background: rgba(0, 0, 0, 0.22);
  object-fit: cover;
}

.detail-media figcaption {
  width: 100%;
  max-width: 100%;
  margin-inline: auto;
  white-space: normal;
  word-break: keep-all;
  overflow-wrap: normal;
  text-wrap: pretty;
}

.detail-media--hackathon .detail-media__frame,
.detail-media--hackathon figcaption {
  width: var(--detail-reward-card-width);
}

.detail-media--hackathon figcaption {
  font-size: 0.76rem;
  line-height: 1.58;
  color: rgba(240, 243, 255, 0.76);
}

@media (min-width: 46rem) {
  .rewards-gallery__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rewards-card--featured {
  border-color: color-mix(in srgb, var(--detail-accent) 40%, rgba(255, 255, 255, 0.2));
}

  .rewards-card--featured .rewards-card__body {
    align-content: center;
  }

  .detail-case {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.4rem;
  padding: 2.2rem;
  border-radius: 2.4rem;
  border: 1px solid rgba(255, 255, 255, 0.05);
  background: linear-gradient(145deg, rgba(20, 22, 35, 0.4), rgba(10, 11, 18, 0.6));
  backdrop-filter: blur(48px);
  -webkit-backdrop-filter: blur(48px);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.15),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05),
    0 32px 64px rgba(0, 0, 0, 0.7);
}

@media (min-width: 1024px) {
  .detail-case {
    grid-template-columns: 1.2fr 1.8fr; /* Split layout for Spatial UI */
    align-items: center;
  }
}

.detail-case__info {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.detail-case__media-window {
  display: block;
  width: 100%;
}


  .detail-case__title-row {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
}

@media (max-width: 28rem) {
  .rewards-gallery__intro {
    flex-direction: column;
    align-items: flex-start;
  }

  .detail-case__gallery--hackathon {
    --detail-reward-card-width: min(84vw, 18.5rem);
    gap: 0.72rem;
  }

  .rewards-card {
  position: relative;
  display: grid;
  gap: 0.9rem;
  padding: 1rem;
  border-radius: 1.8rem;
  border: 1px solid rgba(255, 255, 255, 0.03);
  background: rgba(20, 22, 35, 0.25);
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.08),
    0 16px 32px rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

  .rewards-card__frame {
    min-height: 14rem;
    padding: 0.32rem;
  }

  .detail-nav {
    align-items: flex-start;
  }

  .detail-title {
    min-height: 6.2rem;
  }

  .detail-title h1 {
    margin-top: -1.2rem;
  }

  .detail-hero__summary,
  .detail-hero__lead,
  .detail-section__lead,
  .detail-panel p,
  .detail-step__body p,
  .detail-outcomes li,
  .detail-case__summary,
  .detail-case__highlights li,
  .detail-case__fact,
  .detail-media figcaption {
    font-size: 0.76rem;
  }

  .detail-step {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.82rem;
  align-items: start;
  padding: 1.2rem;
  border-radius: 1.6rem;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

  .detail-case {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.4rem;
  padding: 2.2rem;
  border-radius: 2.4rem;
  border: 1px solid rgba(255, 255, 255, 0.05);
  background: linear-gradient(145deg, rgba(20, 22, 35, 0.4), rgba(10, 11, 18, 0.6));
  backdrop-filter: blur(48px);
  -webkit-backdrop-filter: blur(48px);
  box-shadow: 
    inset 0 1px 1px rgba(255, 255, 255, 0.15),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05),
    0 32px 64px rgba(0, 0, 0, 0.7);
}

@media (min-width: 1024px) {
  .detail-case {
    grid-template-columns: 1.2fr 1.8fr; /* Split layout for Spatial UI */
    align-items: center;
  }
}

.detail-case__info {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.detail-case__media-window {
  display: block;
  width: 100%;
}


  .detail-media {
  position: relative;
  display: grid;
  gap: 0.72rem;
  padding: 0.8rem;
  border-radius: 1.6rem;
  border: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.02);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

  .detail-media__meta {
    gap: 0.5rem;
  }
}

@media (max-height: 43rem) {
  .projects-stage--showcase .projects-stage__header p {
    max-width: 17rem;
    font-size: 0.68rem;
    line-height: 1.42;
  }

  .projects-card-stack {
    gap: 0.8rem;
  }

  .projects-card {
    gap: 0.92rem;
    min-height: 16.4rem;
    padding: 1rem 1rem 1.02rem;
  }

  

  .projects-card__body p {
  margin: 0;
  max-width: 90%;
  font-size: 0.95rem;
  line-height: 1.5;
  font-weight: 300;
  letter-spacing: -0.01em;
  color: rgba(255, 255, 255, 0.8);
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  line-clamp: 3;
}

  .projects-card__note,
  .projects-card__meta {
  display: block;
  font-size: clamp(1.2rem, 4vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -0.02em;
  text-transform: uppercase;
  color: #ffffff;
}
}

.projects-stage--stack {
  --scene-veil-bottom: rgba(18, 21, 58, 0.98);
}

.projects-stage--stack .projects-stage__header {
  gap: 0.62rem;
}







.projects-stage--stack .projects-stage__underline {
  width: 2rem;
  height: 0.12rem;
  box-shadow: none;
}

.projects-stage--stack .projects-stage__header p {
  max-width: 17rem;
  font-size: 0.74rem;
  line-height: 1.42;
  color: rgba(238, 241, 255, 0.48);
}

.projects-ledger {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 0.22rem;
  margin: 1rem 0 0;
  padding: 0;
  list-style: none;
}

.project-ledger__item {
  --ledger-accent: rgba(118, 145, 255, 0.68);
  display: grid;
  grid-template-columns: 2.35rem minmax(0, 1fr);
  gap: 0.82rem;
  padding: 0.9rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.project-ledger__item:last-child {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.project-ledger__item.is-shifted .project-ledger__content {
  margin-left: 0.5rem;
}

.project-ledger__item--violet {
  --ledger-accent: rgba(177, 149, 255, 0.74);
}

.project-ledger__item--cyan {
  --ledger-accent: rgba(97, 225, 255, 0.72);
}

.project-ledger__item--blue {
  --ledger-accent: rgba(101, 156, 255, 0.72);
}

.project-ledger__item--pink {
  --ledger-accent: rgba(250, 129, 220, 0.72);
}

.project-ledger__rail {
  display: grid;
  justify-items: start;
  align-content: start;
  gap: 0.36rem;
  padding-top: 0.14rem;
}

.project-ledger__index {
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  color: rgba(255, 255, 255, 0.82);
}

.project-ledger__divider {
  width: 1rem;
  height: 0.12rem;
  background: color-mix(in srgb, var(--ledger-accent) 78%, transparent);
}

.project-ledger__content {
  display: grid;
  gap: 0.4rem;
}

.project-ledger__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem 0.54rem;
  align-items: center;
}

.project-ledger__eyebrow,
.project-ledger__label {
  font-size: 0.54rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.project-ledger__eyebrow {
  color: rgba(230, 235, 255, 0.44);
}

.project-ledger__label {
  color: color-mix(in srgb, var(--ledger-accent) 48%, white);
}

.project-ledger__content h3 {
  margin: 0;
  max-width: 12.5ch;
  font-size: clamp(1.14rem, 5.2vw, 1.52rem);
  line-height: 1;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: rgba(255, 255, 255, 0.96);
  text-wrap: balance;
}

.project-ledger__content p {
  margin: 0;
  max-width: 17rem;
  font-size: 0.72rem;
  line-height: 1.44;
  letter-spacing: -0.01em;
  color: rgba(236, 239, 255, 0.58);
}

.project-ledger__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.22rem 0.4rem;
  padding-top: 0.16rem;
}

.project-ledger__tags span {
  position: relative;
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(238, 241, 255, 0.44);
}

.project-ledger__tags span:not(:first-child)::before {
  content: "/";
  position: absolute;
  left: -0.28rem;
  color: rgba(238, 241, 255, 0.24);
}

@media (max-height: 43rem) {
  .projects-ledger {
    margin-top: 0.82rem;
  }

  .project-ledger__item {
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.68rem;
    padding: 0.78rem 0;
  }

  .project-ledger__item.is-shifted .project-ledger__content {
    margin-left: 0.24rem;
  }

  .project-ledger__content h3 {
    font-size: clamp(1rem, 4.5vw, 1.32rem);
  }

  .project-ledger__content p {
    font-size: 0.66rem;
    line-height: 1.4;
  }

  .project-ledger__eyebrow,
  .project-ledger__label,
  .project-ledger__tags span {
    font-size: 0.5rem;
  }
}

.scene--career {
  padding: calc(var(--nav-height) + 2rem) var(--page-edge) 5rem;
  --scene-veil-bottom: rgba(18, 20, 46, 0.98);
  background:
    linear-gradient(180deg, rgba(2, 7, 40, 0.99) 0%, rgba(8, 27, 110, 0.98) 31.73%, rgba(11, 63, 146, 0.96) 62.98%, rgba(27, 104, 171, 0.94) 100%),
    #060d2b;
}

.career-stage {
  display: grid;
  gap: 2rem;
}

.career-stage__heading {
  position: relative;
  padding-bottom: 0.2rem;
}

.career-stage__heading span {
  display: block;
  margin-bottom: -0.35rem;
  font-size: clamp(1.5rem, 7vw, 2.2rem);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.38);
  filter: blur(0.9px);
}

.career-stage__heading h2 {
  margin: 0;
  font-size: clamp(2rem, 9vw, 2.75rem);
  font-weight: 900;
  letter-spacing: -0.08em;
}

.career-stage__block {
  display: grid;
  gap: 1rem;
}

.career-stage__label {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.career-stage__label img {
  width: 1.4rem;
  height: 1.4rem;
}

.career-stage__label-icon {
  width: 1.45rem;
  height: 1.45rem;
  color: #66b7ff;
}

.career-stage__label h3 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 900;
}

.career-stage__award-list {
  display: grid;
  gap: 0.95rem;
}

.award-card {
  padding: 1.15rem 1rem 1rem;
  border: 1px solid rgba(132, 168, 255, 0.1);
  border-radius: 1.35rem;
  background: rgba(5, 11, 42, 0.54);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.03),
    0 10px 24px rgba(1, 5, 24, 0.18);
}

.award-card__badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  margin-bottom: 0.75rem;
  padding: 0.34rem 0.64rem;
  border: 1px solid rgba(255, 185, 0, 0.24);
  border-radius: 0.55rem;
  color: rgba(255, 195, 58, 0.92);
  background: rgba(255, 185, 0, 0.08);
  font-size: 0.75rem;
  font-weight: 700;
}

.award-card h4 {
  margin: 0;
  font-size: 1.12rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.award-card p {
  margin: 0.45rem 0 0;
  font-size: 0.95rem;
  line-height: 1.58;
  color: rgba(255, 255, 255, 0.68);
}

.career-timeline {
  --timeline-axis: 0.82rem;
  --timeline-dot-size: 0.88rem;
  --timeline-entry-offset: 2.15rem;
  position: relative;
  display: grid;
  gap: 1rem;
  padding-left: 0;
}

.career-timeline__line,
.career-timeline__line-fill {
  position: absolute;
  top: 0.2rem;
  bottom: 0.2rem;
  left: calc(var(--timeline-axis) - 1px);
  width: 2px;
  border-radius: 999px;
}

.career-timeline__line {
  background: rgba(255, 255, 255, 0.15);
}

.career-timeline__line-fill {
  height: calc(var(--career-progress, 0) * 100%);
  background: linear-gradient(180deg, rgba(43, 127, 255, 0.96), rgba(77, 182, 255, 0.9));
  box-shadow: 0 0 18px rgba(66, 156, 255, 0.55);
}

.timeline-entry {
  position: relative;
  padding-left: var(--timeline-entry-offset);
  opacity: 0.44;
  transform: translateX(0);
  transition:
    opacity 220ms var(--ease-out),
    transform 220ms var(--ease-out);
}

.timeline-entry__dot {
  position: absolute;
  top: 0.4rem;
  left: calc(var(--timeline-axis) - (var(--timeline-dot-size) / 2));
  width: var(--timeline-dot-size);
  height: var(--timeline-dot-size);
  border-radius: 50%;
  background: #2b7fff;
  box-shadow: 0 0 0 rgba(59, 130, 246, 0);
  transform: scale(calc(0.84 + (var(--entry-progress, 0) * 0.24)));
  transition:
    transform 220ms var(--ease-out),
    box-shadow 220ms var(--ease-out),
    background-color 220ms var(--ease-out);
}

.timeline-entry__body {
  padding: 1rem 1rem 1.05rem;
  border-radius: 1.2rem;
  background: rgba(5, 11, 42, 0.42);
  border: 1px solid rgba(132, 168, 255, 0.09);
  box-shadow: 0 10px 24px rgba(1, 5, 24, 0.12);
  transform: translateY(calc((1 - var(--entry-progress, 0)) * 6px));
  transition:
    transform 220ms var(--ease-out),
    border-color 220ms var(--ease-out),
    background-color 220ms var(--ease-out),
    box-shadow 220ms var(--ease-out);
}

.timeline-entry__category {
  display: block;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: rgba(81, 162, 255, 0.88);
  text-transform: uppercase;
}

.timeline-entry__body h4 {
  margin: 0.5rem 0 0;
  font-size: 1.18rem;
  font-weight: 800;
}

.timeline-entry__body small {
  display: block;
  margin-top: 0.35rem;
  font-size: 0.95rem;
  color: rgba(255, 255, 255, 0.5);
}

.timeline-entry__body p {
  margin: 0.75rem 0 0;
  font-size: 0.97rem;
  line-height: 1.64;
  color: rgba(255, 255, 255, 0.7);
}

.timeline-entry__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.9rem;
}

.timeline-entry__tags span {
  padding: 0.36rem 0.62rem;
  border-radius: 0.45rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.58);
  font-size: 0.74rem;
}

.timeline-entry--completed,
.timeline-entry--active {
  opacity: 1;
}

.timeline-entry--completed .timeline-entry__dot {
  background: #79bfff;
  box-shadow: 0 0 20px rgba(102, 183, 255, 0.42);
}

.timeline-entry--active .timeline-entry__dot {
  background: #8cd4ff;
  box-shadow:
    0 0 0 6px rgba(112, 192, 255, 0.12),
    0 0 24px rgba(102, 183, 255, 0.85);
}

.timeline-entry--active .timeline-entry__body {
  border-color: rgba(132, 198, 255, 0.22);
  background: rgba(7, 17, 58, 0.78);
  box-shadow:
    0 18px 34px rgba(1, 6, 30, 0.22),
    0 0 0 1px rgba(116, 194, 255, 0.08);
  transform: translateX(0.28rem)
    translateY(calc((1 - var(--entry-progress, 0)) * 6px));
}

.timeline-entry--completed .timeline-entry__body {
  border-color: rgba(132, 168, 255, 0.16);
}

.timeline-entry--active .timeline-entry__category {
  color: rgba(129, 205, 255, 0.96);
}

.timeline-entry--active .timeline-entry__body h4 {
  color: #fff;
}

.scene--contact {
  min-height: auto;
  --scene-veil-bottom: rgba(0, 0, 0, 0);
  background: linear-gradient(180deg, #080a10 0%, #1a1f1c 100%);
}

.scene--contact .scene__sticky {
  position: relative;
  height: auto;
  overflow: visible;
}

.contact-stage {
  display: grid;
  align-content: start;
  gap: 1.6rem;
  padding: calc(var(--nav-height) + 2rem) var(--page-edge) 4rem;
  isolation: isolate;
  background: rgba(6, 6, 10, 0.06);
}

.contact-stage__burst,
.contact-stage__overlay {
  position: absolute;
  inset: auto;
  pointer-events: none;
}

.contact-stage__burst {
  top: 17%;
  left: 50%;
  width: min(108%, 29rem);
  max-width: none;
  transform-origin: center center;
  opacity: 0.24;
  filter: saturate(1.02) blur(0.4px);
  animation: contact-burst-spin 18s linear infinite;
}

.contact-stage__overlay {
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.54), rgba(0, 0, 0, 0.18) 28%, rgba(0, 0, 0, 0.18) 72%, rgba(0, 0, 0, 0.34)),
    radial-gradient(circle at center, rgba(255, 255, 255, 0.05), transparent 35%);
}

.contact-stage__header,
.contact-stage__cards,
.contact-stage__footer {
  position: relative;
  z-index: 1;
}

.contact-stage__header {
  text-align: center;
}

.contact-stage__header span {
  display: inline-block;
  padding: 0.38rem 0.8rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.contact-stage__header h2 {
  margin: 1rem 0 0.9rem;
  font-size: clamp(2rem, 8.8vw, 3rem);
  line-height: 1.05;
  letter-spacing: -0.08em;
}

.contact-stage__header p {
  margin: 0;
  font-size: 1rem;
  line-height: 1.62;
  color: rgba(255, 255, 255, 0.72);
}

.contact-stage__cards {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.contact-card {
  padding: 1.8rem 1rem;
  border-radius: 1.6rem;
  background: rgba(0, 0, 0, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.06);
  text-align: center;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(14px);
}

.contact-card__icon {
  display: grid;
  width: 3.4rem;
  height: 3.4rem;
  margin: 0 auto 1rem;
  place-items: center;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
}

.contact-card__icon-svg {
  width: 1.4rem;
  height: 1.4rem;
  color: #9dd8ff;
}

.contact-card h3 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 800;
}

.contact-card p {
  margin: 0.6rem 0 0;
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.7);
}

.contact-stage__footer {
  display: grid;
  gap: 0.55rem;
  margin-top: auto;
  padding-top: 2rem;
  text-align: center;
}

.contact-stage__footer p {
  margin: 0;
  font-size: 0.96rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.5);
}

@media (min-width: 36rem) and (max-width: 47.9375rem) {
  .app-stage {
    margin: 1.2rem 0;
    border-radius: 2rem;
    overflow: clip;
  }

  .floating-nav {
    top: 1.5rem;
  }

  .profile-stage__ellipse--top {
    right: -13rem;
    width: 40rem;
  }

  .profile-stage__ellipse--bottom {
    left: -6rem;
    width: 30rem;
  }
}

@keyframes contact-burst-spin {
  from {
    transform: translate(-50%, 0) scale(var(--burst-scale, 0.92)) rotate(0deg);
  }

  to {
    transform: translate(-50%, 0) scale(var(--burst-scale, 0.92)) rotate(360deg);
  }
}

@media (min-width: 768px) {
  :root {
    --page-width: 100%;
    --page-edge: clamp(1.5rem, 4vw, 3rem);
    --nav-height: 6.25rem;
  }

  .app-stage {
    width: 100%;
    box-shadow: none;
    border-radius: 0;
  }

  /* Floating navigation - wider and show brand */
  .floating-nav {
    width: min(calc(100vw - 2rem), 50rem);
    max-width: 50rem;
    top: 0.75rem;
  }

  .floating-nav__brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.52rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .floating-nav__brand strong {
    font-size: 0.82rem;
  }

  .floating-nav__brand span {
    font-size: 0.68rem;
  }

  .floating-nav__links {
    padding: 0.6rem 0.7rem;
    gap: 0.4rem;
  }

  .floating-nav__links a {
    padding: 0.52rem 1rem;
    font-size: 0.82rem;
    min-height: 2.2rem;
  }

  /* Hero section - scale up */
  .hero-stage {
    min-height: max(100svh, 60rem);
    overflow: hidden;
  }

  .hero-stage__brand {
    top: 2.4rem;
    left: 3rem;
  }

  .hero-stage__brand strong {
    font-size: 1.25rem;
  }

  .hero-stage__brand span {
    font-size: 1.08rem;
  }

  .hero-stage__nav {
    top: 6.5rem;
    left: 3rem;
    gap: 1.4rem;
  }

  .hero-stage__nav a {
    font-size: 1.15rem;
  }

  .hero-stage__role {
    top: 9.5rem;
    right: 4rem;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  }

  .hero-stage__visual::before {
    top: 2rem;
    right: -1rem;
    width: 18rem;
    height: 40rem;
  }

  .hero-stage__visual::after {
    top: 18rem;
    right: 6rem;
    width: 22rem;
    height: 18rem;
  }

  .scene--hero {
    --wordmark-top: 24rem;
    --stairs-offset-vw: 15vw;
  }

  .hero-stage__wordmark-port {
    font-size: clamp(7rem, 12vw, 10rem);
  }

  .hero-stage__wordmark-folio {
    font-size: clamp(7.5rem, 13vw, 11rem);
  }

  .hero-stage__copy {
    left: 3rem;
    right: 3rem;
    bottom: 2rem;
    max-width: 28rem;
  }

  .hero-stage__intro,
  .hero-stage__body {
    font-size: 1.08rem;
    line-height: 1.82;
  }

  .hero-stage__stars {
    font-size: 0.78rem;
  }

  /* Profile section - wider card */
  .profile-stage {
    padding: calc(var(--nav-height) + 3.5rem) var(--page-edge) 5rem;
    display: grid;
    place-items: center;
  }

  .profile-card {
    width: 100%;
    max-width: 42rem;
    gap: 2rem;
  }

  .profile-card__heading span {
  display: block;
  margin-bottom: -0.35rem;
  font-size: clamp(1.5rem, 7vw, 2.2rem);
  font-weight: 900;
  color: rgba(255, 255, 255, 0.38);
  filter: blur(0.9px);
}

  .profile-card__heading h2 {
  margin: 0;
  font-size: clamp(2rem, 9vw, 2.75rem);
  font-weight: 900;
  letter-spacing: -0.08em;
}

  .profile-card__canvas {
    width: min(100%, 28rem);
  }

  .profile-card__photo {
    width: min(100%, 26rem);
  }

  .profile-card__editor {
    width: min(100%, 28rem);
  }

  .profile-stage__ellipse--top {
    right: -10rem;
    width: 52rem;
  }

  .profile-stage__ellipse--bottom {
    left: -4rem;
    width: 38rem;
  }

  /* Projects section - wider content */
  .scene--projects {
    padding: calc(var(--nav-height) + 3rem) var(--page-edge) 18rem;
}

  .projects-stage {
    width: min(100%, 42rem);
    margin-inline: auto;
    justify-items: stretch;
  }

  .projects-stage__header {
  width: 100%;
}

  

  

  

  .projects-stage__header p {
  max-width: 30rem;
  font-size: 1rem;
}

  .projects-orbit-shell {
    width: 100%;
  }

  .projects-orbit {
    height: clamp(26rem, 40vh, 32rem);
  }

  .project-orbit-card {
    width: 18rem;
  }

  .projects-wall-shell {
    width: 100%;
  }

  .projects-wall {
    width: 100%;
    grid-template-rows: repeat(6, minmax(0, 4.2rem));
    gap: 0.75rem;
  }

  .project-poster {
    padding: 1rem 1.05rem 1.1rem;
    border-radius: 1.7rem;
  }

  

  .projects-card {
    min-height: 20rem;
    padding: 1.5rem 1.45rem 1.5rem;
    border-radius: 1.85rem;
  }

  /* Career section - wider timeline */
  .scene--career {
    padding: calc(var(--nav-height) + 2.5rem) var(--page-edge) 6rem;
  }

  .career-stage {
    max-width: 42rem;
    margin-inline: auto;
    gap: 2.4rem;
  }

  .career-stage__heading span {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .career-stage__heading h2 {
    font-size: clamp(2.4rem, 5vw, 3.2rem);
  }

  .career-stage__label h3 {
    font-size: 1.5rem;
  }

  .career-timeline {
    --timeline-entry-offset: 2.6rem;
  }

  .timeline-entry__body {
    padding: 1.2rem 1.3rem 1.3rem;
    border-radius: 1.35rem;
  }

  .timeline-entry__body h4 {
    font-size: 1.28rem;
  }

  .timeline-entry__body p {
    font-size: 1.02rem;
  }

  .award-card {
    padding: 1.35rem 1.2rem 1.2rem;
    border-radius: 1.5rem;
  }

  .award-card h4 {
    font-size: 1.22rem;
  }

  /* Contact section - grid layout for cards */
  .contact-stage {
    max-width: 48rem;
    margin-inline: auto;
    gap: 2rem;
    padding: calc(var(--nav-height) + 2.5rem) var(--page-edge) 5rem;
  }

  .contact-stage__header h2 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }

  .contact-stage__header p {
    font-size: 1.08rem;
  }

  .contact-stage__cards {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }

  .contact-card {
    padding: 2rem 1.2rem;
    border-radius: 1.8rem;
  }

  .contact-card h3 {
    font-size: 1.45rem;
  }

  .contact-stage__burst {
    width: min(108%, 38rem);
  }

  /* Detail page - wider content */
  .detail-shell {
    max-width: 48rem;
    margin-inline: auto;
    padding: 1.4rem var(--page-edge) 3rem;
    gap: 1.4rem;
  }

  .detail-nav {
    padding: max(0.8rem, env(safe-area-inset-top)) var(--page-edge) 0.8rem;
  }

  .detail-nav__back,
  .detail-nav__links a {
    padding: 0.52rem 0.9rem;
    font-size: 0.78rem;
    min-height: 2.2rem;
  }

  .detail-title__backdrop {
    font-size: clamp(4.2rem, 8vw, 6rem);
  }

  .detail-title h1 {
    font-size: clamp(3.4rem, 7vw, 5rem);
  }

  /* Rewards gallery */
  .rewards-gallery__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1024px) {
  :root {
    --page-edge: clamp(2rem, 5vw, 4rem);
  }

  .floating-nav {
    width: min(calc(100vw - 3rem), 56rem);
    max-width: 56rem;
  }

  .floating-nav__links a {
    padding: 0.56rem 1.15rem;
    font-size: 0.85rem;
  }

  /* Hero - larger scale */
  .hero-stage__brand {
    top: 2.8rem;
    left: 4rem;
  }

  .hero-stage__brand strong {
    font-size: 1.4rem;
  }

  .hero-stage__brand span {
    font-size: 1.15rem;
  }

  .hero-stage__nav {
    top: 7rem;
    left: 4rem;
    gap: 1.6rem;
  }

  .hero-stage__nav a {
    font-size: 1.25rem;
  }

  .hero-stage__role {
    top: 9.5rem;
    right: 4rem;
    font-size: clamp(2.8rem, 4vw, 4rem);
  }

  .scene--hero {
    --wordmark-top: 26rem;
    --stairs-offset-vw: 24vw;
  }

  .hero-stage__wordmark-port {
    font-size: clamp(8rem, 11vw, 12rem);
  }

  .hero-stage__wordmark-folio {
    font-size: clamp(8.5rem, 12vw, 13rem);
  }

  .hero-stage__copy {
    left: 4rem;
    right: 4rem;
    bottom: 3rem;
    max-width: 32rem;
  }

  .hero-stage__intro,
  .hero-stage__body {
    font-size: 1.14rem;
    line-height: 1.86;
  }

  /* Profile - larger */
  .profile-card {
    width: 100%;
    max-width: 48rem;
    gap: 2.4rem;
  }

  .profile-card__heading span {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .profile-card__heading h2 {
    font-size: clamp(2.4rem, 5vw, 3.2rem);
  }

  .profile-card__canvas {
    width: min(100%, 32rem);
  }

  .profile-card__photo {
    width: min(100%, 30rem);
  }

  .profile-card__editor {
    width: min(100%, 32rem);
  }

  /* Projects - larger */
  .projects-stage {
    width: min(100%, 48rem);
  }

  .projects-stage__backdrop {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
  }

  .projects-stage__header h2 {
    font-size: clamp(2.6rem, 4.5vw, 3.6rem);
  }

  .projects-stage__header p {
    font-size: 1.06rem;
    max-width: 34rem;
  }

  .projects-orbit {
    height: clamp(28rem, 38vh, 34rem);
  }

  .project-orbit-card {
    width: 20rem;
  }

  .projects-wall {
    grid-template-rows: repeat(6, minmax(0, 4.8rem));
    gap: 0.85rem;
  }

  

  .projects-card {
    min-height: 22rem;
    padding: 1.7rem 1.65rem 1.7rem;
  }

  /* Career - larger */
  .career-stage {
    max-width: 48rem;
  }

  .career-stage__heading span {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
  }

  .career-stage__heading h2 {
    font-size: clamp(2.6rem, 4.5vw, 3.6rem);
  }

  .timeline-entry__body {
    padding: 1.4rem 1.5rem 1.5rem;
  }

  .timeline-entry__body h4 {
    font-size: 1.36rem;
  }

  .timeline-entry__body p {
    font-size: 1.06rem;
    line-height: 1.7;
  }

  /* Contact - 3-column grid */
  .contact-stage {
    max-width: 56rem;
  }

  .contact-stage__cards {
    grid-template-columns: repeat(3, 1fr);
  }

  .contact-stage__header h2 {
    font-size: clamp(2.8rem, 4.5vw, 3.8rem);
  }

  .contact-stage__header p {
    font-size: 1.12rem;
  }

  .contact-card {
    padding: 2.2rem 1.3rem;
  }

  /* Detail page - wider */
  .detail-shell {
    max-width: 56rem;
    padding: 1.6rem var(--page-edge) 3.5rem;
  }

  .detail-title__backdrop {
    font-size: clamp(4.8rem, 7vw, 7rem);
  }

  .detail-title h1 {
    font-size: clamp(3.8rem, 6vw, 5.6rem);
  }

  .rewards-gallery__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 1280px) {
  :root {
    --page-edge: clamp(2.5rem, 5vw, 5rem);
  }

  .scene--hero,
  .hero-stage {
    min-height: max(100svh, 64rem);
  }

  .projects-stage {
    width: min(100%, 54rem);
  }

  .career-stage {
    max-width: 54rem;
  }

  .contact-stage {
    max-width: 62rem;
  }

  .detail-shell {
    max-width: 62rem;
  }

  .hero-stage__wordmark-port {
    font-size: clamp(9rem, 10vw, 13rem);
  }

  .hero-stage__wordmark-folio {
    font-size: clamp(9.5rem, 11vw, 14rem);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}


/* No-Image Typography & Aura */
.projects-card__top,
.projects-card__body,
.projects-card__footer {
  position: relative;
  z-index: 1;
}

.projects-card__body {
  margin-top: auto;
}

.projects-card__typography {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  border-radius: 1.7rem;
}

.projects-card__huge-index {
  position: absolute;
  right: -5%;
  bottom: -15%;
  font-size: clamp(10rem, 25vw, 15rem);
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: -0.06em;
  color: rgba(255,255,255,0.015);
  z-index: 0;
  transition: transform 600ms var(--ease-out), color 600ms;
}

.projects-card:hover .projects-card__huge-index {
  transform: translateY(-5%) scale(1.05);
  color: rgba(255,255,255,0.035);
}

.projects-card__marquee {
  position: absolute;
  top: 40%;
  left: -20%;
  width: 140%;
  transform: translateY(-50%) rotate(-12deg);
  opacity: 0.04;
  transition: opacity 400ms, transform 500ms var(--ease-out);
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  overflow: hidden;
}

.projects-card:hover .projects-card__marquee {
  opacity: 0.45;
  transform: translateY(-50%) rotate(-8deg) scale(1.05);
}

.projects-card__marquee-track {
  display: flex;
  gap: 1rem;
  white-space: nowrap;
  animation: txt-marquee 30s linear infinite;
  will-change: transform;
}
.projects-card__marquee-track--reverse {
  animation-direction: reverse;
  animation-duration: 35s;
}

.projects-card__marquee-track span {
  font-size: clamp(3.5rem, 8vw, 5rem);
  font-weight: 900;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.8);
}

@keyframes txt-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* Enhancing the Aura (before) */
.projects-card::before {
  content: "";
  position: absolute;
  inset: auto -20% -50% -20%;
  height: 120%;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--project-accent) 26%, transparent), transparent 70%);
  opacity: 0.4;
  filter: blur(40px);
  pointer-events: none;
  transition: opacity 400ms, transform 600ms;
}

.projects-card:hover::before {
  opacity: 0.7;
  transform: scale(1.1) translateY(-10%);
}

.projects-card__line {
  width: 100%;
  height: 1px;
  background: rgba(255, 255, 255, 0.1);
  margin: 1rem 0;
  transition: background 400ms;
}
.projects-card:hover .projects-card__line {
  background: color-mix(in srgb, var(--project-accent) 50%, rgba(255,255,255,0.2));
}

.detail-case__media-window {
    width: 100%;
    min-width: 0; 
}
.detail-case__gallery-shell {
    width: 100%;
    min-width: 0;
}
.detail-case__gallery {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    padding-bottom: 1rem;
    min-width: 0;
}
.detail-media {
    flex: 0 0 100%;
    scroll-snap-align: start;
    width: 100%;
}
.detail-media__frame {
    aspect-ratio: 16 / 9;
    width: 100%;
    height: auto;
}
.detail-media img,
.detail-media video {
    width: 100%;
    height: 100%;
    object-fit: cover !important; 
    border-radius: 0.8rem;
}

/* Hide scrollbar for the swiper to make it feel like native touch swipe */
.detail-case__gallery::-webkit-scrollbar {
  display: none;
}
.detail-case__gallery {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

/* Adjust gallery header for Bento */
.detail-case__gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.detail-case__gallery-header span {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
}

.detail-case__gallery-header small {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--detail-accent) 60%, rgba(255,255,255,0.4));
}

/* Global Image Fixes */
.rewards-card__frame {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 0.8rem;
    overflow: hidden;
    background: rgba(0,0,0,0.5);
}

.rewards-card--featured .rewards-card__frame {
    aspect-ratio: 16 / 9 !important;
}

.rewards-card__frame img,
.rewards-card__frame video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
}


/* Bento Collage Grid for Gallery */
.detail-case__gallery--bento {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    grid-auto-flow: row !important;
    gap: 1.2rem !important;
    overflow: visible !important;
    touch-action: auto !important;
    scroll-snap-type: none !important;
    padding-bottom: 0 !important;
}

.detail-case__gallery--bento .detail-media {
    flex: unset !important;
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    height: auto !important;
    scroll-snap-align: none !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
    padding: 0 !important;
    gap: 0.8rem !important;
}

/* 1st image spans full width, others take 1 column */
.detail-case__gallery--bento .detail-media:first-child {
    grid-column: 1 / -1 !important;
}

.detail-case__gallery--bento .detail-media__frame {
    width: 100% !important;
    height: auto !important;
    position: relative !important;
    border-radius: 0.8rem !important;
    overflow: hidden !important;
}

.detail-case__gallery--bento .detail-media img,
.detail-case__gallery--bento .detail-media video {
    position: relative !important;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
    border-radius: 0.8rem !important;
    background: rgba(0,0,0,0.2) !important;
}


/* Parallax Masonry Grid */
.detail-case__gallery-shell--masonry {
    width: 100%;
    min-width: 0;
    overflow: hidden; /* prevents parallax items from expanding window */
    padding-block: 2rem;
}

.detail-case__gallery--masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: start;
    overflow: visible;
}

.masonry-column {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
}

@media (min-width: 768px) {
    .detail-case__gallery--masonry-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
    }
    .masonry-column {
        gap: 2rem;
    }
    .masonry-column--2 {
        margin-top: 4rem;
    }
}


.masonry-item {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    width: 100%;
}

.masonry-item .detail-media__frame {
    width: 100%;
    position: relative;
    border-radius: 0.8rem;
    overflow: hidden;
    background: rgba(0,0,0,0.5);
    /* natural height! */
    height: auto;
}

.masonry-item img,
.masonry-item video {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0.8rem;
}

.masonry-item figcaption {
    font-size: 0.8rem;
    line-height: 1.62;
    color: rgba(233, 237, 255, 0.7);
    margin: 0;
}


/* Fix forced aspect ratios from global classes */
.masonry-item .detail-media__frame {
    aspect-ratio: auto !important;
    height: auto !important;
}

.masonry-item img,
.masonry-item video {
    position: relative !important; /* Remove absolute if it was set */
    height: auto !important;
    object-fit: contain !important;
}
